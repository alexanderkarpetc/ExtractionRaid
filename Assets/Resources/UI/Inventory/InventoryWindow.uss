/* Inventory modal — Tier A. All shared values pull from _tokens.uss via var(--*).
 * Mirrors WeaponBuilderWindow.uss patterns (header/body, modal chrome).
 *
 * Layout (Stage 3 polish):
 *   - Main window left-anchored, holds only the player pane.
 *   - Floating sub-panels stack to the right of the window — one per nearby
 *     lootable / corpse / floor inventory / hideout stash (matches legacy
 *     uGUI multi-container layout).
 *
 * See docs/ai/ui-styling.md for the token catalogue + naming rules. */

.inv-backdrop {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    /* Fully transparent — інвентар без full-screen dim'у; game world видно
     * everywhere except where inv-window/sub-panels overlap. Builder теж
     * transparent (wb-backdrop) for parity. Token --color-modal-backdrop
     * лишається у _tokens.uss для future modals, що захочуть dim. */
    background-color: rgba(0, 0, 0, 0);
    align-items: flex-start;
    justify-content: flex-start;
    /* All four paddings shared з Builder через токени. Edge-gap забезпечує
     * симетричний зазор з обох сторін екрану + центр (1920 = gap×3 +
     * inv + builder). Vertical clear'ять HUD top + hotbar bottom. */
    padding-left: var(--space-modal-edge-gap);
    padding-top: var(--space-modal-clear-top);
    padding-bottom: var(--space-modal-clear-bottom);
}

.inv-inner {
    flex-direction: row;
    align-items: stretch;
    flex-grow: 1;
    /* Fade in/out — clas `.inv-fading` driven from C# в Open/Close.
     * Matches WeaponBuilderWindow.fadeDuration (160ms у коді з 10ms safety
     * над css transition). */
    opacity: 1;
    transition-property: opacity;
    transition-duration: 0.15s;
    transition-timing-function: ease-out;
}

.inv-fading {
    opacity: 0;
}

.inv-window {
    /* Player-pane-only modal. Width tuned tight до 5×backpack grid:
     *   5×102 + 4×9 gap = 546 content
     *   + pane padding 24 + pane border 2 = 572 pane outer
     *   + body padding 24 = 596 body outer
     *   + window border 4 = 600 window, плюс 4px buffer = 604.
     * Vertical size is governed by inv-inner's stretch (фіксована ширина,
     * висота тягнеться по доступному простору між top/bottom paddings). */
    width: 604px;
    flex-shrink: 0;
    background-color: var(--color-modal-window-bg);
    border-color: var(--color-border);
    border-width: var(--border-window);
    border-radius: var(--radius-window);
    padding: 0;
}

/* ── Header ─────────────────────────────────────────── */

.inv-header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    /* flex-shrink: 0 — header не стискається коли body має багато контенту. */
    flex-shrink: 0;
    /* Longhand — Unity USS shorthand `padding` with var() refs not
     * reliably resolved, тож розписуємо per-axis. Compact y-padding для
     * shared header look. */
    padding-top: var(--space-header-pad-y);
    padding-right: var(--space-modal-pad-x);
    padding-bottom: var(--space-header-pad-y);
    padding-left: var(--space-modal-pad-x);
    border-bottom-width: var(--border-window);
    border-bottom-color: var(--color-border-inset);
    background-color: var(--color-modal-header-bg);
}

.inv-title {
    font-size: var(--font-window-title);
    color: var(--color-text-title);
    -unity-font-style: bold;
}

.inv-credits {
    margin-left: 16px;
    margin-right: auto;
    font-size: 18px;
    color: rgb(255, 215, 90);
    -unity-font-style: bold;
}

.inv-close-btn {
    width: var(--size-header-close-btn);
    height: var(--size-header-close-btn);
    background-color: transparent;
    border-width: 0;
    color: var(--color-text-button-cancel);
    font-size: 36px;
    -unity-font-style: bold;
    padding: 0;
}

.inv-close-btn:hover {
    background-color: var(--color-btn-cancel-bg);
    border-radius: var(--radius-inset);
}

/* ── Body (single player pane) ──────────────────────── */

.inv-body {
    flex-direction: column;
    /* Tighter padding than the canonical modal token — інвентар компактний,
     * 14/12 economises horizontal room for the 5-column backpack grid
     * (Builder side-by-side fits cleanly без overlap'у). */
    padding: 14px 12px;
    flex-grow: 1;
    flex-shrink: 1;
}

.inv-pane {
    padding: 12px;
    background-color: var(--color-modal-pane-bg);
    border-color: var(--color-border-inset);
    border-width: var(--border-inset);
    border-radius: var(--radius-inset);
}

.inv-pane--player {
    flex-grow: 1;
}

.inv-section-heading {
    font-size: var(--font-section-heading);
    -unity-font-style: bold;
    color: var(--color-section-heading);
    margin-bottom: 8px;
}

.inv-placeholder {
    font-size: var(--font-empty-placeholder);
    color: var(--color-text-empty);
    -unity-text-align: middle-center;
    -unity-font-style: italic;
}

/* ── Equipment row ──────────────────────────────────── */

.inv-equipment-row {
    flex-direction: row;
    margin-bottom: 16px;
}

/* ── Backpack grid ──────────────────────────────────── */

.inv-backpack-grid {
    flex-direction: row;
    flex-wrap: wrap;
}

/* ── Slot visuals ──────────────────────────────────────
 * `.inv-slot*` + `.inv-drag-ghost` rules live in `_inv-slot.uss` (imported
 * via Style src) — shared verbatim with the hotbar. When tweaking slot
 * sizing/colors/ghost styling, edit `_inv-slot.uss`; both surfaces update.
 */

/* ── Floating sub-panels (loot / floor / stash) ─────── */

.inv-subpanels {
    flex-direction: column;
    margin-left: 12px;
    /* Full height of the stretched .inv-inner so stacked sub-panels (trade +
     * floor) can shrink into the available space instead of running off the
     * bottom of the screen. Panels stay content-sized up to their max-height,
     * and justify-content defaults to flex-start, so a single panel still hugs
     * the top exactly as before. */
    align-self: stretch;
    justify-content: flex-start;
}

.inv-subpanel {
    margin-bottom: 10px;
    padding: 12px;
    background-color: var(--color-modal-window-bg);
    border-color: var(--color-border);
    border-width: var(--border-window);
    border-radius: var(--radius-window);
    /* Width = grid (666, see .inv-subpanel__grid) + 12 scroller gutter
     * + 24 padding + 4 border. The old 685px left no room for the vertical
     * scroller, so the 6-column grid silently wrapped to 5 while the C#-applied
     * `.inv-slot--row-end` still zeroed every 6th cell's gap — that's what made
     * the columns look glued together. Fixed width keeps layout stable between
     * trades even when stock is smaller. */
    width: 706px;
    flex-shrink: 1;
}

.inv-subpanel__title {
    font-size: var(--font-section-heading);
    -unity-font-style: bold;
    color: var(--color-section-heading);
    margin-bottom: 8px;
    flex-shrink: 0;
}

.inv-subpanel__scroll {
    flex-grow: 1;
    flex-shrink: 1;
    /* Exactly 4 rows of cells (4 × 102 + 4 × 7 bottom margins = 436) so the
     * viewport never cuts a row in half. min-height: 0 lets the panel compress
     * below that when several sub-panels stack. */
    max-height: 436px;
    min-height: 0;
}

.inv-subpanel__grid {
    flex-direction: row;
    flex-wrap: wrap;
    /* 6 × (102 cell + 9 right margin) — wrapping is measured against this
     * explicit width, not against the scroller-dependent viewport, so the
     * column count never flips when the scrollbar appears. */
    width: 666px;
    flex-shrink: 0;
}

/* ── Sub-panel scrollbar (thin, themed) ─────────────────
 * Unity's stock ScrollView scroller is a wide track with up/down arrow buttons
 * and a chunky grey dragger. Same treatment as ControlsOverlay / NotesWindow. */

.inv-subpanel__scroll .unity-scroller--vertical {
    width: 10px;
    background-color: rgba(0, 0, 0, 0);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    margin-left: 2px;
}

/* Drop the up/down arrow buttons entirely. */
.inv-subpanel__scroll .unity-scroller--vertical .unity-scroller__low-button,
.inv-subpanel__scroll .unity-scroller--vertical .unity-scroller__high-button {
    display: none;
}

/* The slider fills the full height now that the buttons are gone. */
.inv-subpanel__scroll .unity-scroller--vertical .unity-base-slider--vertical {
    margin-top: 0;
    margin-bottom: 0;
}

/* Transparent track. */
.inv-subpanel__scroll .unity-scroller--vertical .unity-base-slider__tracker {
    background-color: rgba(0, 0, 0, 0);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
}

/* Rounded thumb, tinted with the section-heading accent. */
.inv-subpanel__scroll .unity-scroller--vertical #unity-dragger {
    width: 6px;
    min-height: 36px;
    border-radius: 3px;
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    margin-left: 2px;
    background-color: rgba(140, 175, 210, 0.30);
}

.inv-subpanel__scroll .unity-scroller--vertical #unity-dragger:hover {
    background-color: rgba(140, 175, 210, 0.55);
}

/* Slots inside a sub-panel use the same dimensions as the main backpack
 * (104×104) — visual consistency makes cross-pane drag feel native. */

/* ── Context menu (right-click) ──────────────────────── */

.inv-ctx-menu {
    position: absolute;
    background-color: var(--color-window-bg);
    border-color: var(--color-border);
    border-width: var(--border-window);
    border-radius: var(--radius-inset);
    padding: 4px 0;
    min-width: 180px;
}

.inv-ctx-menu__list {
    flex-direction: column;
}

.inv-ctx-menu__btn {
    background-color: transparent;
    border-width: 0;
    border-radius: 0;
    padding: 6px 14px;
    margin: 0;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    -unity-text-align: middle-left;
}

.inv-ctx-menu__btn:hover {
    background-color: var(--color-card-bg-hover);
}

.inv-ctx-menu__label {
    font-size: var(--font-card-kind);
    color: var(--color-text-body);
    flex-grow: 1;
}

.inv-ctx-menu__hotkey {
    font-size: var(--font-card-kind);
    color: var(--color-text-muted);
    margin-left: 12px;
}
