/* Inventory slot — shared visual contract.
 *
 * Used by:
 *   - InventoryWindow (backpack grid + equipment row + loot/floor/stash sub-panels)
 *   - HotbarOverlay   (bottom-center strip — reuses `.inv-slot--bp` 102×102 cells
 *                      for pixel-perfect parity з inventory items)
 *
 * Imported via <Style src=".../_inv-slot.uss" /> in each consumer's UXML.
 * Tokens pulled from _tokens.uss (loaded globally via Theme.tss).
 *
 * Naming pattern: `.inv-slot`           — base cell
 *                 `.inv-slot__<part>`   — child labels / bars
 *                 `.inv-slot--<kind>`   — backpack vs equipment variants
 *                 `.inv-slot-drag-*`    — drag-target highlight overlay
 *                 `.inv-drag-ghost`     — floating ghost that follows the cursor.
 */

/* ── Slot — common ──────────────────────────────────── */

.inv-slot {
    background-color: var(--color-card-bg);
    border-color: var(--color-border);
    border-width: var(--border-inset);
    border-radius: var(--radius-inset);
    padding: var(--space-card-pad-y) var(--space-card-pad-x);
    overflow: hidden;
}

.inv-slot__icon {
    position: absolute;
    left: 6px;
    right: 6px;
    top: 20px;
    bottom: 18px;
    -unity-background-scale-mode: scale-to-fit;
    opacity: 0.6;
}

.inv-slot__empty {
    font-size: var(--font-empty-placeholder);
    color: var(--color-text-empty);
    -unity-font-style: italic;
    -unity-text-align: middle-center;
    flex-grow: 1;
}

.inv-slot__name {
    font-size: var(--font-card-title);
    -unity-font-style: bold;
    color: var(--color-text-title);
    white-space: normal;
    flex-grow: 1;
}

.inv-slot__resource {
    font-size: var(--font-card-kind);
    color: var(--color-text-secondary);
    position: absolute;
    right: 6px;
    bottom: 4px;
}

.inv-slot__key {
    font-size: var(--font-card-kind);
    -unity-font-style: bold;
    color: var(--color-accent);
    position: absolute;
    left: 6px;
    top: 4px;
    background-color: var(--color-header-bg);
    padding: 1px 6px;
    border-radius: 4px;
}

.inv-slot__price {
    position: absolute;
    left: 4px;
    bottom: 4px;
    padding: 1px 6px;
    font-size: 12px;
    -unity-font-style: bold;
    color: rgb(255, 215, 90);
    background-color: rgba(0, 0, 0, 0.55);
    border-radius: 4px;
}

.inv-slot__quest {
    width: 8px;
    height: 8px;
    background-color: var(--color-accent);
    border-radius: 4px;
    position: absolute;
    right: 6px;
    top: 6px;
}

/* Dual-rarity corner brackets for built weapons — Payload (top-left) +
 * Delivery (bottom-right). Geometry here; per-item colors set in
 * InventorySlotElement.UpdateRarityFrame. Hidden for empty / non-weapon slots. */
.inv-slot__rarity-tl {
    position: absolute;
    left: 3px;
    top: 3px;
    width: 13px;
    height: 13px;
    border-left-width: 2px;
    border-top-width: 2px;
    border-right-width: 0;
    border-bottom-width: 0;
    border-radius: 0;
}

.inv-slot__rarity-br {
    position: absolute;
    right: 3px;
    bottom: 3px;
    width: 13px;
    height: 13px;
    border-left-width: 0;
    border-top-width: 0;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-radius: 0;
}

/* Mod pips (top-right) — one dot per installed attachment. */
.inv-slot__mod-pips {
    position: absolute;
    right: 6px;
    top: 6px;
    flex-direction: row;
}

.inv-slot__mod-pip {
    width: 6px;
    height: 6px;
    border-radius: 3px;
    margin-left: 3px;
    background-color: var(--color-text-secondary);
}

/* Free attachment slot — yellow-orange "!" call-to-action ("can upgrade"). */
.inv-slot__mod-free {
    margin: 0;
    margin-left: 2px;
    padding: 0;
    font-size: 12px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: var(--color-mod-hint);
}

.inv-slot__durability {
    position: absolute;
    left: 6px;
    right: 6px;
    bottom: 2px;
    height: 3px;
    background-color: var(--color-border-inset);
    border-radius: 2px;
    overflow: hidden;
}

.inv-slot__durability-fill {
    height: 100%;
    width: 100%;
    border-radius: 2px;
}

/* ── Slot — backpack variant ────────────────────────── */

.inv-slot--bp {
    /* Square cells, 5 per row. 5×102 + 4×9 gap = 546, fits pane internal.
     * Spacing 9 (horizontal) × 7 (vertical) mirrors the legacy uGUI
     * GridLayoutGroup cell spacing for visual parity. Longhand margins:
     * Unity USS shorthand `margin: 0 9px 7px 0` does NOT cleanly override
     * via a later `margin-right` rule, тому розписуємо per-axis. */
    width: 102px;
    height: 102px;
    margin-top: 0;
    margin-right: 9px;
    margin-bottom: 7px;
    margin-left: 0;
    justify-content: flex-start;
}

/* Last cell of a row drops the trailing right-margin so 5 cells fit без
 * переносу на 4-per-row. Applied у C# через AddToClassList (USS pseudo-class
 * :nth-child() is not supported by Unity's UI Toolkit parser). */
.inv-slot--row-end {
    margin-right: 0;
}

.inv-slot--bp .inv-slot__name {
    font-size: 12px;
}

/* ── Slot — equipment variant ───────────────────────── */

.inv-slot--eq {
    /* Fixed landscape cells — row left-aligns, free space на правому boku
     * intentional для future equipment slots (e.g. throwable). */
    width: 128px;
    height: 104px;
    margin-right: 6px;
    justify-content: flex-start;
    flex-shrink: 0;
}

.inv-slot--eq:last-child {
    margin-right: 0;
}

/* ── Drag-and-drop visuals ──────────────────────────── */

.inv-slot-drag-valid {
    border-color: var(--color-drag-valid-border);
    background-color: var(--color-drag-valid-bg);
}

.inv-slot-drag-invalid {
    border-color: var(--color-drag-invalid-border);
    background-color: var(--color-drag-invalid-bg);
}

/* Attachment-compatibility highlight — yellow-orange (matches the mod "!" CTA + tooltip
 * accent). Lit on weapons when hovering/dragging a fitting mod, and on mods when hovering
 * a weapon. Drag-target valid/invalid (above) layers on top for the slot under the cursor. */
.inv-slot--compat {
    border-color: var(--color-mod-hint);
    background-color: rgba(255, 170, 50, 0.12);
}

/* Ghost is a clone of the source slot that follows the cursor while dragging.
 * Mounted on _root (absolute coords) so it floats above the window. */
.inv-drag-ghost {
    position: absolute;
    opacity: 0.85;
    border-color: var(--color-accent);
    border-width: 2px;
}
