.root {
    flex-grow: 1;
    background-color: rgba(0, 0, 0, 0);
}

/* Bottom-left anchor matching the concept HTML */
.anchor {
    position: absolute;
    left: 36px;
    bottom: 30px;
    right: 36px;
    max-width: 820px;
    flex-direction: row;
    align-items: flex-end;
}

/* ── Portrait ─────────────────────────────────────────── */
.portrait {
    width: 116px;
    height: 116px;
    margin-right: 14px;
    border-radius: 18px;
    background-color: rgb(26, 36, 54);
    border-color: rgba(255, 255, 255, 0.12);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    overflow: hidden;
}

.portrait-glow {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
    background-color: rgba(63, 93, 134, 0.35);
}

.portrait-head {
    position: absolute;
    left: 34px;
    top: 24px;
    width: 48px;
    height: 48px;
    border-radius: 24px;
    background-color: rgba(255, 255, 255, 0.14);
}

.portrait-shoulders {
    position: absolute;
    left: 16px;
    right: 16px;
    bottom: 12px;
    height: 38px;
    border-top-left-radius: 999px;
    border-top-right-radius: 999px;
    background-color: rgba(255, 255, 255, 0.08);
}

/* ── Panel ────────────────────────────────────────────── */
.panel {
    flex-grow: 1;
    min-height: 154px;
    padding: 14px 16px 14px 16px;
    background-color: rgba(18, 24, 42, 0.92);
    border-color: rgba(255, 255, 255, 0.12);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-radius: 22px;
}

/* ── Nameplate ────────────────────────────────────────── */
.nameplate {
    flex-direction: row;
    align-items: center;
    align-self: flex-start;
    min-height: 30px;
    margin-bottom: 10px;
    padding: 6px 12px;
    border-radius: 999px;
    background-color: rgba(135, 230, 255, 0.18);
    border-color: rgba(135, 230, 255, 0.22);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
}

.nameplate-dot {
    width: 8px;
    height: 8px;
    border-radius: 4px;
    margin-right: 8px;
    background-color: rgb(135, 230, 255);
}

.nameplate-text {
    color: rgb(223, 249, 255);
    font-size: 13px;
    -unity-font-style: normal;
}

/* ── Text box ─────────────────────────────────────────── */
.text-box {
    min-height: 62px;
    padding: 6px 2px 10px 2px;
    color: rgb(238, 244, 255);
    font-size: 18px;
    white-space: normal;
}

/* ── Choices ──────────────────────────────────────────── */
.choices {
    flex-direction: column;
    margin-top: 8px;
    padding-top: 10px;
    border-top-width: 1px;
    border-top-color: rgba(255, 255, 255, 0.08);
}

.choice {
    flex-direction: row;
    align-items: center;
    padding: 12px 14px;
    margin-top: 6px;
    border-radius: 14px;
    background-color: rgba(255, 255, 255, 0.02);
    border-color: rgba(255, 255, 255, 0.06);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    color: rgb(238, 244, 255);
    -unity-text-align: middle-left;
}

.choice:hover {
    background-color: rgba(255, 255, 255, 0.06);
    border-color: rgba(135, 230, 255, 0.32);
}

.choice .index {
    min-width: 24px;
    margin-right: 6px;
    color: rgb(135, 230, 255);
    -unity-font-style: bold;
    font-size: 16px;
}

.choice .choice-label {
    color: rgb(238, 244, 255);
    font-size: 16px;
    flex-grow: 1;
}

/* ── Hint row ─────────────────────────────────────────── */
.hint-row {
    position: absolute;
    right: 16px;
    bottom: 12px;
    flex-direction: row;
}

.hint {
    color: rgb(159, 176, 208);
    font-size: 12px;
    margin-left: 12px;
}
