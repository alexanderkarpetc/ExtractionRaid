/* Weapon Builder modal — D&D layout (Tier 1-2 + UX pass).
 *
 * Layout:
 *   header
 *   body
 *     topRow:  [palette ───────────] [buildPanel ─────────────]
 *     backpackPanel: [thumbnails ─────────────────────────────]
 *   footer
 *
 * Sizes follow Tier A scale — see docs/ai/ui-styling.md. */

.wb-backdrop {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.55);
    align-items: center;
    justify-content: center;
}

.wb-window {
    width: 1280px;
    background-color: rgb(26, 28, 34);
    border-color: rgb(70, 75, 85);
    border-width: 2px;
    border-radius: 12px;
    padding: 0;
}

/* ── Header ─────────────────────────────────────────── */

.wb-header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 24px 32px;
    border-bottom-width: 2px;
    border-bottom-color: rgb(50, 55, 65);
    background-color: rgb(30, 33, 40);
}

.wb-title {
    font-size: 32px;
    color: rgb(235, 240, 250);
    -unity-font-style: bold;
}

.wb-close-btn {
    width: 52px;
    height: 52px;
    background-color: transparent;
    border-width: 0;
    color: rgb(200, 205, 215);
    font-size: 36px;
    -unity-font-style: bold;
    padding: 0;
}

.wb-close-btn:hover {
    background-color: rgb(55, 60, 70);
    border-radius: 8px;
}

/* ── Body ───────────────────────────────────────────── */

.wb-body {
    padding: 24px 32px;
}

.wb-top-row {
    flex-direction: row;
}

.wb-section-heading {
    font-size: 22px;
    -unity-font-style: bold;
    color: rgb(140, 175, 210);
    margin-bottom: 14px;
}

/* ── Palette (left column) ──────────────────────────── */

.wb-palette {
    width: 580px;
    margin-right: 24px;
    padding: 20px;
    background-color: rgb(22, 24, 30);
    border-color: rgb(50, 55, 65);
    border-width: 1px;
    border-radius: 8px;
}

.wb-palette-group-label {
    font-size: 18px;
    color: rgb(150, 155, 165);
    margin-top: 12px;
    margin-bottom: 8px;
}

.wb-palette-grid {
    flex-direction: row;
    flex-wrap: wrap;
}

.wb-card {
    width: 160px;
    height: 96px;
    margin: 0 8px 8px 0;
    padding: 12px 14px;
    background-color: rgb(38, 42, 52);
    border-color: rgb(70, 75, 85);
    border-width: 2px;
    border-radius: 8px;
    flex-direction: column;
    justify-content: space-between;
}

.wb-card:hover {
    background-color: rgb(48, 54, 66);
    border-color: rgb(120, 195, 235);
}

.wb-card-selected {
    border-color: rgb(230, 200, 140);
    background-color: rgb(48, 44, 36);
}

.wb-card-title {
    font-size: 22px;
    -unity-font-style: bold;
    color: rgb(235, 240, 250);
    white-space: normal;
}

.wb-card-kind {
    font-size: 18px;
    color: rgb(190, 200, 215);
    -unity-text-align: middle-left;
}

/* ── Build panel (right column) ─────────────────────── */

.wb-build-panel {
    flex-grow: 1;
    padding: 20px;
    background-color: rgb(22, 24, 30);
    border-color: rgb(50, 55, 65);
    border-width: 1px;
    border-radius: 8px;
}

.wb-slots-host {
    flex-direction: column;
    margin-bottom: 16px;
}

.wb-slot {
    height: 88px;
    margin-bottom: 12px;
    padding: 14px 20px;
    background-color: rgb(30, 33, 40);
    border-color: rgb(70, 75, 85);
    border-width: 2px;
    border-radius: 8px;
    justify-content: center;
}

.wb-slot-empty {
    font-size: 20px;
    color: rgb(120, 130, 145);
    -unity-text-align: middle-center;
    -unity-font-style: italic;
}

.wb-slot-filled {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.wb-slot-filled-state {
    border-color: rgb(120, 195, 235);
    background-color: rgb(34, 42, 54);
}

.wb-slot-filled-title {
    font-size: 22px;
    -unity-font-style: bold;
    color: rgb(235, 240, 250);
}

.wb-slot-filled-kind {
    font-size: 18px;
    color: rgb(190, 200, 215);
    flex-grow: 1;
    margin-left: 12px;
}

.wb-slot-clear {
    width: 36px;
    height: 36px;
    background-color: transparent;
    border-width: 0;
    color: rgb(200, 205, 215);
    font-size: 26px;
    -unity-font-style: bold;
    padding: 0;
}

.wb-slot-clear:hover {
    background-color: rgb(70, 50, 50);
    border-radius: 6px;
}

.wb-slot-drag-valid {
    border-color: rgb(80, 200, 120);
    background-color: rgb(28, 44, 34);
}

.wb-slot-drag-invalid {
    border-color: rgb(200, 80, 80);
    background-color: rgb(50, 28, 28);
}

/* ── Preview ────────────────────────────────────────── */

.wb-preview {
    padding: 20px;
    background-color: rgb(30, 33, 40);
    border-color: rgb(50, 55, 65);
    border-width: 1px;
    border-radius: 8px;
}

.wb-archetype {
    font-size: 28px;
    -unity-font-style: bold;
    color: rgb(230, 200, 140);
    margin-bottom: 8px;
}

.wb-hint {
    font-size: 18px;
    -unity-font-style: italic;
    color: rgb(120, 195, 235);
    margin-bottom: 14px;
    white-space: normal;
}

.wb-stats-grid {
    flex-direction: column;
}

.wb-stat-row {
    flex-direction: row;
    justify-content: space-between;
    padding: 3px 0;
}

.wb-stat-label {
    color: rgb(180, 190, 205);
    font-size: 22px;
}

.wb-stat-value {
    color: rgb(230, 235, 245);
    font-size: 22px;
    -unity-font-style: bold;
}

.wb-error {
    color: rgb(220, 100, 100);
    font-size: 18px;
    margin-top: 12px;
    white-space: normal;
}

/* ── Backpack panel (bottom strip) ──────────────────── */

.wb-backpack-panel {
    margin-top: 24px;
    padding: 20px;
    background-color: rgb(22, 24, 30);
    border-color: rgb(50, 55, 65);
    border-width: 1px;
    border-radius: 8px;
}

.wb-backpack-grid {
    flex-direction: row;
    flex-wrap: wrap;
}

.wb-bp-item {
    width: 152px;
    height: 88px;
    margin: 0 8px 8px 0;
    padding: 10px 14px;
    background-color: rgb(30, 33, 40);
    border-color: rgb(50, 55, 65);
    border-width: 1px;
    border-radius: 8px;
    flex-direction: column;
    justify-content: space-between;
}

.wb-bp-item:hover {
    border-color: rgb(120, 195, 235);
}

.wb-bp-item-empty {
    background-color: rgba(0, 0, 0, 0);
    border-color: rgb(38, 42, 50);
}

/* Empty slots stay quiet on hover — no tooltip, so no point flashing the border. */
.wb-bp-item-empty:hover {
    border-color: rgb(38, 42, 50);
}

/* Built weapons get a gold accent so the player spots their own builds among
 * ammo / medkits / armor pieces. Same gold as the archetype label. */
.wb-bp-item-weapon {
    border-color: rgb(230, 200, 140);
    background-color: rgb(36, 32, 26);
}

.wb-bp-item-weapon:hover {
    border-color: rgb(245, 215, 155);
}

.wb-bp-item-name {
    font-size: 18px;
    color: rgb(220, 225, 235);
    -unity-font-style: bold;
    white-space: normal;
}

.wb-bp-item-count {
    font-size: 16px;
    color: rgb(180, 190, 205);
    -unity-text-align: middle-right;
}

/* ── Footer ─────────────────────────────────────────── */

.wb-footer {
    flex-direction: row;
    justify-content: flex-end;
    padding: 24px 32px;
    border-top-width: 2px;
    border-top-color: rgb(50, 55, 65);
    background-color: rgb(30, 33, 40);
}

.wb-btn {
    min-width: 200px;
    height: 56px;
    margin-left: 16px;
    border-radius: 8px;
    border-width: 1px;
    font-size: 22px;
    -unity-font-style: bold;
}

.wb-btn-cancel {
    background-color: rgb(55, 60, 70);
    border-color: rgb(70, 75, 85);
    color: rgb(200, 205, 215);
}

.wb-btn-cancel:hover {
    background-color: rgb(65, 70, 80);
}

.wb-btn-build {
    background-color: rgb(60, 130, 90);
    border-color: rgb(80, 160, 110);
    color: rgb(240, 250, 245);
}

.wb-btn-build:hover {
    background-color: rgb(70, 150, 105);
}

.wb-btn-build:disabled {
    background-color: rgb(45, 55, 50);
    border-color: rgb(55, 65, 60);
    color: rgb(130, 140, 135);
}

/* ── Drag ghost (lives directly on the document root during drag) ── */

.wb-drag-ghost {
    position: absolute;
    opacity: 0.85;
    /* card sizing inherited via wb-card class */
}
