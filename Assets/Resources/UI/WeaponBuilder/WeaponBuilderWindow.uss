/* Weapon Builder modal — D&D layout (Tier 1-2 + UX pass).
 *
 * Layout (post-Tier 6 Wave A — embedded backpack removed; uGUI inventory canvas
 * opens side-by-side instead, see docs/ai/weapon-builder/plan/roadmap.md):
 *   header
 *   body
 *     topRow:  [palette ───────────] [buildPanel ─────────────]
 *   footer
 *
 * Sizes follow Tier A scale — see docs/ai/ui-styling.md. */

.wb-backdrop {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    /* Transparent: side-by-side layout means inventory is visible to the left,
     * dim would just obscure it. Builder window has its own bg + border so it
     * stays visually distinct without a backdrop tint. */
    background-color: rgba(0, 0, 0, 0);
    /* Right-anchored: Builder positioned on the right of the viewport so the uGUI
     * inventory canvas (left-anchored at 0..~31% width) can sit alongside without
     * overlap. See docs/ai/weapon-builder/plan/roadmap.md → Tier 6 Wave A. */
    align-items: flex-end;
    justify-content: center;
    padding-right: 32px;
}

.wb-window {
    width: 1280px;
    /* Hard cap at the reference panel height (1080 ref px). With
     * ScaleWithScreenSize this fits 16:9 screens at any resolution because the
     * panel layout space is always 1920×1080 ref. C# UpdateWindowMaxHeight
     * tightens this further at runtime for non-16:9 aspects (ultrawide) where
     * panel ref height drops below 1080. */
    max-height: 1080px;
    background-color: rgb(26, 28, 34);
    border-color: rgb(70, 75, 85);
    border-width: 2px;
    border-radius: 12px;
    padding: 0;
    opacity: 1;
    transition-property: opacity;
    transition-duration: 0.15s;
    transition-timing-function: ease-out;
}

/* Pre-open and post-close opacity gate. The window starts hidden, gets `display:Flex`,
 * then has this class removed next frame to drive the fade-in. On Close the class is
 * added, the transition runs, then the runtime sets display:None after the timer. */
.wb-window-fading {
    opacity: 0;
}

/* ── Header ─────────────────────────────────────────── */

.wb-header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 24px 32px;
    border-bottom-width: 2px;
    border-bottom-color: rgb(50, 55, 65);
    background-color: rgb(30, 33, 40);
}

.wb-title {
    font-size: 26px;
    color: rgb(235, 240, 250);
    -unity-font-style: bold;
}

.wb-close-btn {
    width: 52px;
    height: 52px;
    background-color: transparent;
    border-width: 0;
    color: rgb(200, 205, 215);
    font-size: 36px;
    -unity-font-style: bold;
    padding: 0;
}

.wb-close-btn:hover {
    background-color: rgb(55, 60, 70);
    border-radius: 8px;
}

/* ── Body ───────────────────────────────────────────── */

.wb-body {
    padding: 24px 32px;
    /* ScrollView fills the space between header and footer; content scrolls when
     * the natural content height exceeds the viewport. */
    flex-grow: 1;
    flex-shrink: 1;
}

.wb-top-row {
    flex-direction: row;
}

.wb-section-heading {
    font-size: 18px;
    -unity-font-style: bold;
    color: rgb(140, 175, 210);
    margin-bottom: 12px;
}

/* ── Palette (left column) ──────────────────────────── */

.wb-palette {
    width: 580px;
    margin-right: 24px;
    padding: 20px;
    background-color: rgb(22, 24, 30);
    border-color: rgb(50, 55, 65);
    border-width: 1px;
    border-radius: 8px;
}

.wb-palette-group-label {
    font-size: 14px;
    color: rgb(150, 155, 165);
    margin-top: 10px;
    margin-bottom: 6px;
}

.wb-palette-grid {
    flex-direction: row;
    flex-wrap: wrap;
}

.wb-card {
    width: 144px;
    height: 80px;
    margin: 0 8px 8px 0;
    padding: 10px 12px;
    background-color: rgb(38, 42, 52);
    border-color: rgb(70, 75, 85);
    border-width: 2px;
    border-radius: 8px;
    flex-direction: column;
    justify-content: space-between;
}

.wb-card:hover {
    background-color: rgb(48, 54, 66);
    border-color: rgb(120, 195, 235);
}

.wb-card-selected {
    border-color: rgb(230, 200, 140);
    background-color: rgb(48, 44, 36);
}

/* Tier 6 G4: dimmed look for modules player doesn't currently own у backpack.
 * Visual cue — player знає що йому не хватає для Build. Click/drag still work
 * (CanBuild + DisabledReason gate the actual Build). */
.wb-card-unavailable {
    opacity: 0.45;
    border-color: rgb(50, 55, 65);
    background-color: rgb(28, 30, 36);
}

.wb-card-unavailable:hover {
    background-color: rgb(28, 30, 36);
    border-color: rgb(50, 55, 65);
}

.wb-card-title {
    font-size: 18px;
    -unity-font-style: bold;
    color: rgb(235, 240, 250);
    white-space: normal;
}

.wb-card-kind {
    font-size: 14px;
    color: rgb(190, 200, 215);
    -unity-text-align: middle-left;
}

/* ── Build panel (right column) ─────────────────────── */

.wb-build-panel {
    flex-grow: 1;
    padding: 20px;
    background-color: rgb(22, 24, 30);
    border-color: rgb(50, 55, 65);
    border-width: 1px;
    border-radius: 8px;
}

.wb-slots-host {
    flex-direction: column;
    margin-bottom: 16px;
}

.wb-slot {
    height: 72px;
    margin-bottom: 10px;
    padding: 12px 16px;
    background-color: rgb(30, 33, 40);
    border-color: rgb(70, 75, 85);
    border-width: 2px;
    border-radius: 8px;
    justify-content: center;
}

.wb-slot-empty {
    font-size: 16px;
    color: rgb(120, 130, 145);
    -unity-text-align: middle-center;
    -unity-font-style: italic;
}

.wb-slot-filled {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.wb-slot-filled-state {
    border-color: rgb(120, 195, 235);
    background-color: rgb(34, 42, 54);
}

.wb-slot-filled-title {
    font-size: 18px;
    -unity-font-style: bold;
    color: rgb(235, 240, 250);
}

.wb-slot-filled-kind {
    font-size: 14px;
    color: rgb(190, 200, 215);
    flex-grow: 1;
    margin-left: 10px;
}

.wb-slot-clear {
    width: 30px;
    height: 30px;
    background-color: transparent;
    border-width: 0;
    color: rgb(200, 205, 215);
    font-size: 22px;
    -unity-font-style: bold;
    padding: 0;
}

.wb-slot-clear:hover {
    background-color: rgb(70, 50, 50);
    border-radius: 6px;
}

.wb-slot-drag-valid {
    border-color: rgb(80, 200, 120);
    background-color: rgb(28, 44, 34);
}

.wb-slot-drag-invalid {
    border-color: rgb(200, 80, 80);
    background-color: rgb(50, 28, 28);
}

/* ── Preview ────────────────────────────────────────── */

.wb-preview {
    padding: 16px;
    background-color: rgb(30, 33, 40);
    border-color: rgb(50, 55, 65);
    border-width: 1px;
    border-radius: 8px;
}

.wb-archetype {
    font-size: 22px;
    -unity-font-style: bold;
    color: rgb(230, 200, 140);
    margin-bottom: 4px;
}

.wb-archetype-flavor {
    font-size: 14px;
    -unity-font-style: italic;
    color: rgb(170, 175, 185);
    margin-bottom: 10px;
    white-space: normal;
}

.wb-archetype-flavor.is-empty {
    display: none;
}

.wb-hint {
    font-size: 14px;
    -unity-font-style: italic;
    color: rgb(120, 195, 235);
    margin-bottom: 12px;
    white-space: normal;
}

.wb-stat-group-heading {
    font-size: 14px;
    -unity-font-style: bold;
    color: rgb(140, 175, 210);
    margin-top: 8px;
    margin-bottom: 3px;
}

.wb-stat-group-heading.first {
    margin-top: 0;
}

.wb-stats-grid {
    flex-direction: column;
}

.wb-stat-row {
    flex-direction: row;
    justify-content: space-between;
    padding: 2px 0;
    /* Belt-and-suspenders against text overlap if anything else in the layout
     * misbehaves: rows refuse to shrink below their natural reading size. */
    min-height: 22px;
    flex-shrink: 0;
}

.wb-stat-label {
    color: rgb(180, 190, 205);
    font-size: 16px;
}

.wb-stat-value {
    color: rgb(230, 235, 245);
    font-size: 16px;
    -unity-font-style: bold;
}

.wb-error {
    color: rgb(220, 100, 100);
    font-size: 14px;
    margin-top: 10px;
    white-space: normal;
}

/* ── Footer ─────────────────────────────────────────── */

.wb-footer {
    flex-direction: row;
    justify-content: flex-end;
    padding: 24px 32px;
    border-top-width: 2px;
    border-top-color: rgb(50, 55, 65);
    background-color: rgb(30, 33, 40);
}

.wb-btn {
    min-width: 160px;
    height: 44px;
    margin-left: 14px;
    border-radius: 8px;
    border-width: 1px;
    font-size: 18px;
    -unity-font-style: bold;
}

.wb-btn-cancel {
    background-color: rgb(55, 60, 70);
    border-color: rgb(70, 75, 85);
    color: rgb(200, 205, 215);
}

.wb-btn-cancel:hover {
    background-color: rgb(65, 70, 80);
}

.wb-btn-build {
    background-color: rgb(60, 130, 90);
    border-color: rgb(80, 160, 110);
    color: rgb(240, 250, 245);
}

.wb-btn-build:hover {
    background-color: rgb(70, 150, 105);
}

.wb-btn-build:disabled {
    background-color: rgb(45, 55, 50);
    border-color: rgb(55, 65, 60);
    color: rgb(130, 140, 135);
}

/* ── Drag ghost (lives directly on the document root during drag) ── */

.wb-drag-ghost {
    position: absolute;
    opacity: 0.85;
    /* card sizing inherited via wb-card class */
}
