/* Weapon Builder modal — D&D layout (Tier 1-2 + UX pass).
 *
 * Layout (post-Tier 6 Wave A — embedded backpack removed; uGUI inventory canvas
 * opens side-by-side instead, see docs/ai/weapon-builder/plan/roadmap.md):
 *   header
 *   body
 *     topRow:  [palette ───────────] [buildPanel ─────────────]
 *   footer
 *
 * This stylesheet is the canonical Tier A reference. All shared values pull
 * from `Assets/Resources/UI/Theme/_tokens.uss` via `var(--*)` — colors, fonts,
 * spacing, sizing. Only weapon-builder-specific layout (palette width, drag
 * ghost positioning) lives as literals here.
 *
 * See docs/ai/ui-styling.md for the token catalogue + naming rules. */

.wb-backdrop {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    /* Transparent: side-by-side layout means inventory is visible to the left,
     * dim would just obscure it. Builder window has its own bg + border so it
     * stays visually distinct without a backdrop tint. */
    background-color: rgba(0, 0, 0, 0);
    /* Right-anchored: Builder positioned on the right of the viewport so the uGUI
     * inventory canvas (left-anchored at 0..~31% width) can sit alongside without
     * overlap. See docs/ai/weapon-builder/plan/roadmap.md → Tier 6 Wave A. */
    align-items: flex-end;
    justify-content: center;
    padding-right: 32px;
}

.wb-window {
    width: var(--size-window-width);
    /* Hard cap at the reference panel height (1080 ref px). With
     * ScaleWithScreenSize this fits 16:9 screens at any resolution because the
     * panel layout space is always 1920×1080 ref. C# UpdateWindowMaxHeight
     * tightens this further at runtime for non-16:9 aspects (ultrawide) where
     * panel ref height drops below 1080. */
    max-height: 1080px;
    background-color: var(--color-window-bg);
    border-color: var(--color-border);
    border-width: var(--border-window);
    border-radius: var(--radius-window);
    padding: 0;
    opacity: 1;
    transition-property: opacity;
    transition-duration: 0.15s;
    transition-timing-function: ease-out;
}

/* Pre-open and post-close opacity gate. The window starts hidden, gets `display:Flex`,
 * then has this class removed next frame to drive the fade-in. On Close the class is
 * added, the transition runs, then the runtime sets display:None after the timer. */
.wb-window-fading {
    opacity: 0;
}

/* ── Header ─────────────────────────────────────────── */

.wb-header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-modal-pad-y) var(--space-modal-pad-x);
    border-bottom-width: var(--border-window);
    border-bottom-color: var(--color-border-inset);
    background-color: var(--color-header-bg);
}

.wb-title {
    font-size: var(--font-window-title);
    color: var(--color-text-title);
    -unity-font-style: bold;
}

.wb-close-btn {
    width: 52px;
    height: 52px;
    background-color: transparent;
    border-width: 0;
    color: var(--color-text-button-cancel);
    font-size: 36px;
    -unity-font-style: bold;
    padding: 0;
}

.wb-close-btn:hover {
    background-color: var(--color-btn-cancel-bg);
    border-radius: var(--radius-inset);
}

/* ── Body ───────────────────────────────────────────── */

.wb-body {
    padding: var(--space-modal-pad-y) var(--space-modal-pad-x);
    /* ScrollView fills the space between header and footer; content scrolls when
     * the natural content height exceeds the viewport. */
    flex-grow: 1;
    flex-shrink: 1;
}

.wb-top-row {
    flex-direction: row;
}

.wb-section-heading {
    font-size: var(--font-section-heading);
    -unity-font-style: bold;
    color: var(--color-section-heading);
    margin-bottom: 12px;
}

/* ── Palette (left column) ──────────────────────────── */

.wb-palette {
    width: 580px;
    margin-right: 24px;
    padding: 20px;
    background-color: var(--color-inset-bg);
    border-color: var(--color-border-inset);
    border-width: var(--border-inset);
    border-radius: var(--radius-inset);
}

.wb-palette-group-label {
    font-size: var(--font-group-label);
    color: var(--color-text-muted);
    margin-top: 10px;
    margin-bottom: 6px;
}

.wb-palette-grid {
    flex-direction: row;
    flex-wrap: wrap;
}

.wb-card {
    width: var(--size-card-width);
    height: var(--size-card-height);
    margin: 0 8px 8px 0;
    padding: var(--space-card-pad-y) var(--space-card-pad-x);
    background-color: var(--color-card-bg);
    border-color: var(--color-border);
    border-width: var(--border-window);
    border-radius: var(--radius-inset);
    flex-direction: column;
    justify-content: space-between;
}

.wb-card:hover {
    background-color: var(--color-card-bg-hover);
    border-color: var(--color-hint);
}

.wb-card-selected {
    border-color: var(--color-accent);
    background-color: var(--color-card-bg-selected);
}

/* Tier 6 G4: dimmed look for modules player doesn't currently own у backpack.
 * Visual cue — player знає що йому не хватає для Build. Click/drag still work
 * (CanBuild + DisabledReason gate the actual Build). */
.wb-card-unavailable {
    opacity: 0.45;
    border-color: var(--color-border-inset);
    background-color: var(--color-card-bg-disabled);
}

.wb-card-unavailable:hover {
    background-color: var(--color-card-bg-disabled);
    border-color: var(--color-border-inset);
}

.wb-card-title {
    font-size: var(--font-card-title);
    -unity-font-style: bold;
    color: var(--color-text-title);
    white-space: normal;
}

.wb-card-kind {
    font-size: var(--font-card-kind);
    color: var(--color-text-secondary);
    -unity-text-align: middle-left;
}

/* ── Build panel (right column) ─────────────────────── */

.wb-build-panel {
    flex-grow: 1;
    padding: 20px;
    background-color: var(--color-inset-bg);
    border-color: var(--color-border-inset);
    border-width: var(--border-inset);
    border-radius: var(--radius-inset);
}

.wb-slots-host {
    flex-direction: column;
    margin-bottom: 16px;
}

.wb-slot {
    height: var(--size-slot-height);
    margin-bottom: 10px;
    padding: var(--space-slot-pad-y) var(--space-slot-pad-x);
    background-color: var(--color-header-bg);
    border-color: var(--color-border);
    border-width: var(--border-window);
    border-radius: var(--radius-inset);
    justify-content: center;
}

.wb-slot-empty {
    font-size: var(--font-empty-placeholder);
    color: var(--color-text-empty);
    -unity-text-align: middle-center;
    -unity-font-style: italic;
}

.wb-slot-filled {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.wb-slot-filled-state {
    border-color: var(--color-state-fill-border);
    background-color: var(--color-state-fill-bg);
}

.wb-slot-filled-title {
    font-size: var(--font-card-title);
    -unity-font-style: bold;
    color: var(--color-text-title);
}

.wb-slot-filled-kind {
    font-size: var(--font-card-kind);
    color: var(--color-text-secondary);
    flex-grow: 1;
    margin-left: 10px;
}

.wb-slot-clear {
    width: 30px;
    height: 30px;
    background-color: transparent;
    border-width: 0;
    color: var(--color-text-button-cancel);
    font-size: 22px;
    -unity-font-style: bold;
    padding: 0;
}

.wb-slot-clear:hover {
    background-color: rgb(70, 50, 50);
    border-radius: 6px;
}

.wb-slot-drag-valid {
    border-color: var(--color-drag-valid-border);
    background-color: var(--color-drag-valid-bg);
}

.wb-slot-drag-invalid {
    border-color: var(--color-drag-invalid-border);
    background-color: var(--color-drag-invalid-bg);
}

/* ── Preview ────────────────────────────────────────── */

.wb-preview {
    padding: 16px;
    background-color: var(--color-header-bg);
    border-color: var(--color-border-inset);
    border-width: var(--border-inset);
    border-radius: var(--radius-inset);
}

.wb-archetype {
    font-size: var(--font-preview-archetype);
    -unity-font-style: bold;
    color: var(--color-accent);
    margin-bottom: 4px;
}

.wb-archetype-flavor {
    font-size: var(--font-tooltip-flavor);
    -unity-font-style: italic;
    color: var(--color-text-flavor);
    margin-bottom: 10px;
    white-space: normal;
}

.wb-archetype-flavor.is-empty {
    display: none;
}

.wb-hint {
    font-size: var(--font-tooltip-flavor);
    -unity-font-style: italic;
    color: var(--color-hint);
    margin-bottom: 12px;
    white-space: normal;
}

.wb-stat-group-heading {
    font-size: var(--font-tooltip-flavor);
    -unity-font-style: bold;
    color: var(--color-section-heading);
    margin-top: 8px;
    margin-bottom: 3px;
}

.wb-stat-group-heading.first {
    margin-top: 0;
}

.wb-stats-grid {
    flex-direction: column;
}

.wb-stat-row {
    flex-direction: row;
    justify-content: space-between;
    padding: var(--space-row-pad-y) 0;
    /* Belt-and-suspenders against text overlap if anything else in the layout
     * misbehaves: rows refuse to shrink below their natural reading size. */
    min-height: var(--size-stat-row-mh);
    flex-shrink: 0;
}

.wb-stat-label {
    color: var(--color-text-stat-label);
    font-size: var(--font-stat-label);
}

.wb-stat-value {
    color: var(--color-text-body-strong);
    font-size: var(--font-stat-value);
    -unity-font-style: bold;
}

.wb-error {
    color: var(--color-error);
    font-size: var(--font-tooltip-flavor);
    margin-top: 10px;
    white-space: normal;
}

/* ── Footer ─────────────────────────────────────────── */

.wb-footer {
    flex-direction: row;
    justify-content: flex-end;
    padding: var(--space-modal-pad-y) var(--space-modal-pad-x);
    border-top-width: var(--border-window);
    border-top-color: var(--color-border-inset);
    background-color: var(--color-header-bg);
}

.wb-btn {
    min-width: var(--size-button-min-width);
    height: var(--size-button-height);
    margin-left: 14px;
    border-radius: var(--radius-inset);
    border-width: var(--border-inset);
    font-size: var(--font-button);
    -unity-font-style: bold;
}

.wb-btn-cancel {
    background-color: var(--color-btn-cancel-bg);
    border-color: var(--color-btn-cancel-border);
    color: var(--color-text-button-cancel);
}

.wb-btn-cancel:hover {
    background-color: var(--color-btn-cancel-bg-hover);
}

.wb-btn-build {
    background-color: var(--color-btn-build-bg);
    border-color: var(--color-btn-build-border);
    color: var(--color-btn-build-text);
}

.wb-btn-build:hover {
    background-color: var(--color-btn-build-bg-hover);
}

.wb-btn-build:disabled {
    background-color: var(--color-btn-build-bg-disabled);
    border-color: var(--color-btn-build-border-disabled);
    color: var(--color-btn-build-text-disabled);
}

/* ── Drag ghost (lives directly on the document root during drag) ── */

.wb-drag-ghost {
    position: absolute;
    opacity: 0.85;
    /* card sizing inherited via wb-card class */
}
