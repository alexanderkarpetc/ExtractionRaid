<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements">
    <Style src="WeaponBuilderWindow.uss" />
    <ui:VisualElement name="backdrop" class="wb-backdrop">
        <ui:VisualElement name="window" class="wb-window">
            <ui:VisualElement name="header" class="wb-header">
                <ui:Label text="Weapon Builder" class="wb-title" />
                <ui:Button name="closeBtn" text="×" class="wb-close-btn" />
            </ui:VisualElement>

            <ui:VisualElement name="body" class="wb-body">

                <ui:VisualElement class="wb-row">
                    <ui:Label text="Payload" class="wb-row-label" />
                    <ui:DropdownField name="payloadDropdown" class="wb-dropdown" />
                </ui:VisualElement>

                <ui:VisualElement class="wb-row">
                    <ui:Label text="Delivery" class="wb-row-label" />
                    <ui:DropdownField name="deliveryDropdown" class="wb-dropdown" />
                </ui:VisualElement>

                <ui:VisualElement name="previewBox" class="wb-preview">
                    <ui:Label name="archetypeLabel" text="—" class="wb-archetype" />
                    <ui:Label name="chargeHint" class="wb-hint" />
                    <ui:VisualElement name="statsGrid" class="wb-stats-grid" />
                    <ui:Label name="errorLabel" class="wb-error" />
                </ui:VisualElement>

            </ui:VisualElement>

            <ui:VisualElement class="wb-footer">
                <ui:Button name="cancelBtn" text="Cancel" class="wb-btn wb-btn-cancel" />
                <ui:Button name="buildBtn" text="Build" class="wb-btn wb-btn-build" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
