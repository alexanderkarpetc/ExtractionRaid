/* Quest popup — UI Toolkit port of Assets/Concepts/quest-ui-popup.html.
 * Self-contained colours (no token dependency) so the visual matches the
 * concept exactly; mirrors the approach in UI/Dialogue/NpcDialogue.uss.
 * Sizes are tuned for the 1920x1080 reference resolution (PanelSettings
 * ScaleWithScreenSize) — roughly 1.5x the concept's browser-window values so
 * text stays readable, matching the project's font tokens (18-26px). */

.qp-root {
    flex-grow: 1;
    background-color: rgba(0, 0, 0, 0);
}

/* ── Overlay / backdrop ──────────────────────────────── */
.qp-overlay {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
    background-color: rgba(4, 6, 12, 0.72);
    align-items: center;
    justify-content: center;
}

/* ── Popup window ────────────────────────────────────── */
.qp-popup {
    width: 1180px;
    max-width: 96%;
    max-height: 88%;
    background-color: rgba(10, 13, 20, 0.98);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
    border-radius: 14px;
    overflow: hidden;
    flex-direction: column;
}

/* ── Header ──────────────────────────────────────────── */
.qp-header {
    padding-top: 24px;
    padding-left: 30px;
    padding-right: 30px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(26, 32, 48);
}

.qp-header-top {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 18px;
}

.qp-title-area {
    flex-direction: row;
    align-items: center;
}

.qp-title {
    font-size: 26px;
    -unity-font-style: bold;
    letter-spacing: 4px;
    color: rgb(255, 255, 255);
}

/* NPC pill (NPC mode only) */
.qp-npc-pill {
    flex-direction: row;
    align-items: center;
    margin-left: 20px;
    padding-top: 7px;
    padding-bottom: 7px;
    padding-left: 10px;
    padding-right: 14px;
    background-color: rgb(22, 27, 40);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-color: rgb(36, 46, 66);
    border-radius: 8px;
}

.qp-npc-avatar {
    width: 32px;
    height: 32px;
    margin-right: 10px;
    border-radius: 6px;
    background-color: rgb(28, 34, 53);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-color: rgb(36, 46, 66);
}

.qp-npc-pill-name {
    font-size: 16px;
    -unity-font-style: bold;
    color: rgb(224, 228, 236);
}

.qp-npc-pill-role {
    font-size: 12px;
    letter-spacing: 1px;
    margin-left: 10px;
    color: rgb(136, 146, 166);
}

.qp-close {
    width: 40px;
    height: 40px;
    border-radius: 8px;
    background-color: rgb(22, 27, 40);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-color: rgb(36, 46, 66);
    color: rgb(176, 184, 200);
    font-size: 20px;
}

.qp-close:hover {
    border-color: rgb(46, 58, 82);
    color: rgb(224, 228, 236);
}

/* ── Tabs ────────────────────────────────────────────── */
.qp-tabs {
    flex-direction: row;
}

.qp-tab {
    padding-top: 12px;
    padding-bottom: 13px;
    padding-left: 28px;
    padding-right: 28px;
    margin-left: 0;
    margin-right: 4px;
    background-color: rgba(0, 0, 0, 0);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 3px;
    border-bottom-color: rgba(0, 0, 0, 0);
    border-radius: 0;
    font-size: 15px;
    letter-spacing: 1px;
    color: rgb(136, 146, 166);
}

.qp-tab:hover {
    color: rgb(224, 228, 236);
}

.qp-tab--active {
    color: rgb(255, 255, 255);
    border-bottom-color: rgb(74, 124, 255);
}

/* ── Body (scroll) ───────────────────────────────────── */
.qp-body {
    flex-grow: 1;
    padding-top: 22px;
    padding-left: 30px;
    padding-right: 30px;
    padding-bottom: 28px;
}

/* ── Quest card ──────────────────────────────────────── */
.qp-card {
    margin-bottom: 14px;
    background-color: rgb(17, 21, 32);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-color: rgb(36, 46, 66);
    border-radius: 10px;
    overflow: hidden;
}

.qp-card--active {
    border-color: rgba(74, 124, 255, 0.3);
}

.qp-card-hdr {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding-top: 15px;
    padding-bottom: 14px;
    padding-left: 18px;
    padding-right: 18px;
}

.qp-card--open .qp-card-hdr {
    border-bottom-width: 1px;
    border-bottom-color: rgb(36, 46, 66);
}

.qp-card-hdr-left {
    flex-direction: row;
    align-items: center;
}

.qp-card-hdr-right {
    flex-direction: row;
    align-items: center;
}

.qp-icon {
    width: 36px;
    height: 36px;
    margin-right: 14px;
    border-radius: 8px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
}

.qp-icon--available {
    background-color: rgba(212, 160, 23, 0.12);
    border-color: rgba(212, 160, 23, 0.22);
}

.qp-icon--active {
    background-color: rgba(74, 124, 255, 0.12);
    border-color: rgba(74, 124, 255, 0.22);
}

.qp-icon--done {
    background-color: rgba(46, 204, 113, 0.10);
    border-color: rgba(46, 204, 113, 0.2);
}

.qp-name {
    font-size: 19px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
}

.qp-badge {
    font-size: 12px;
    letter-spacing: 1px;
    margin-left: 10px;
    padding-top: 4px;
    padding-bottom: 4px;
    padding-left: 10px;
    padding-right: 10px;
    border-radius: 5px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
}

.qp-badge--new {
    background-color: rgba(212, 160, 23, 0.12);
    color: rgb(212, 160, 23);
    border-color: rgba(212, 160, 23, 0.2);
}

.qp-badge--active {
    background-color: rgba(74, 124, 255, 0.12);
    color: rgb(74, 124, 255);
    border-color: rgba(74, 124, 255, 0.2);
}

.qp-badge--done {
    background-color: rgba(46, 204, 113, 0.10);
    color: rgb(46, 204, 113);
    border-color: rgba(46, 204, 113, 0.18);
}

.qp-chevron {
    margin-left: 12px;
    font-size: 15px;
    color: rgb(136, 146, 166);
}

.qp-npc-tag {
    flex-direction: row;
    align-items: center;
    font-size: 13px;
    letter-spacing: 1px;
    color: rgb(136, 146, 166);
}

.qp-npc-dot {
    width: 7px;
    height: 7px;
    margin-right: 7px;
    border-radius: 4px;
    background-color: rgba(74, 124, 255, 0.7);
}

/* ── Card body ───────────────────────────────────────── */
.qp-card-body {
    padding-top: 16px;
    padding-bottom: 20px;
    padding-left: 18px;
    padding-right: 18px;
}

.qp-desc {
    font-size: 16px;
    margin-bottom: 14px;
    color: rgb(176, 184, 200);
    white-space: normal;
}

/* Objectives */
.qp-obj-list {
    flex-direction: column;
}

.qp-obj-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 7px;
    padding-top: 9px;
    padding-bottom: 9px;
    padding-left: 13px;
    padding-right: 13px;
    background-color: rgb(22, 27, 40);
    border-radius: 7px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-color: rgb(26, 32, 48);
}

.qp-obj-check {
    width: 20px;
    height: 20px;
    margin-right: 12px;
    border-radius: 4px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-color: rgb(46, 58, 82);
}

.qp-obj-check--done {
    background-color: rgb(46, 204, 113);
    border-color: rgb(46, 204, 113);
}

.qp-obj-text {
    flex-grow: 1;
    font-size: 16px;
    color: rgb(224, 228, 236);
    white-space: normal;
}

.qp-obj-text--done {
    color: rgb(136, 146, 166);
}

.qp-obj-progress {
    min-width: 42px;
    font-size: 14px;
    -unity-text-align: middle-right;
    color: rgb(136, 146, 166);
}

.qp-obj-progress--full {
    color: rgb(46, 204, 113);
}

.qp-material-list {
    margin-left: 45px;
    margin-right: 8px;
    margin-top: -1px;
    margin-bottom: 9px;
    padding-top: 8px;
    padding-bottom: 6px;
    padding-left: 12px;
    padding-right: 12px;
    background-color: rgba(10, 13, 20, 0.55);
    border-left-width: 2px;
    border-left-color: rgb(46, 58, 82);
}

.qp-material-title {
    margin-bottom: 5px;
    font-size: 12px;
    letter-spacing: 1px;
    color: rgb(136, 146, 166);
}

.qp-material-row {
    min-height: 26px;
    flex-direction: row;
    align-items: center;
}

.qp-material-name {
    flex-grow: 1;
    font-size: 14px;
    color: rgb(176, 184, 200);
}

.qp-material-name--ready,
.qp-material-count--ready {
    color: rgb(46, 204, 113);
}

.qp-material-count {
    min-width: 52px;
    font-size: 14px;
    -unity-text-align: middle-right;
    color: rgb(212, 160, 23);
}

/* Progress bar */
.qp-progress-row {
    flex-direction: row;
    align-items: center;
    margin-top: 16px;
}

.qp-progress-track {
    flex-grow: 1;
    height: 5px;
    margin-right: 14px;
    background-color: rgb(8, 10, 16);
    border-radius: 3px;
    overflow: hidden;
}

.qp-progress-fill {
    height: 100%;
    border-radius: 3px;
    background-color: rgb(74, 124, 255);
}

.qp-progress-fill--green {
    background-color: rgb(46, 204, 113);
}

.qp-progress-label {
    min-width: 44px;
    font-size: 13px;
    -unity-text-align: middle-right;
    color: rgb(136, 146, 166);
}

/* Rewards */
.qp-rewards-row {
    flex-direction: row;
    align-items: center;
    flex-wrap: wrap;
    margin-top: 16px;
}

.qp-rewards-label {
    font-size: 13px;
    letter-spacing: 1px;
    margin-right: 12px;
    color: rgb(136, 146, 166);
}

.qp-reward-chip {
    flex-direction: row;
    align-items: center;
    margin-right: 10px;
    margin-bottom: 6px;
    padding-top: 6px;
    padding-bottom: 6px;
    padding-left: 11px;
    padding-right: 11px;
    background-color: rgb(22, 27, 40);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-color: rgb(36, 46, 66);
    border-radius: 7px;
    font-size: 15px;
    color: rgb(224, 228, 236);
}

.qp-reward-dot {
    width: 8px;
    height: 8px;
    margin-right: 7px;
    border-radius: 4px;
    background-color: rgb(212, 160, 23);
}

/* Actions */
.qp-actions {
    flex-direction: row;
    justify-content: flex-end;
    margin-top: 16px;
}

.qp-btn {
    margin-left: 10px;
    padding-top: 10px;
    padding-bottom: 10px;
    padding-left: 24px;
    padding-right: 24px;
    border-radius: 8px;
    font-size: 15px;
    letter-spacing: 1px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-color: rgba(0, 0, 0, 0);
}

.qp-btn--primary {
    background-color: rgb(74, 124, 255);
    color: rgb(255, 255, 255);
    border-color: rgb(74, 124, 255);
}

.qp-btn--primary:hover {
    background-color: rgb(90, 140, 255);
    border-color: rgb(90, 140, 255);
}

/* Empty state */
.qp-empty {
    align-items: center;
    justify-content: center;
    padding-top: 56px;
    padding-bottom: 56px;
    opacity: 0.4;
}

.qp-empty-icon {
    width: 44px;
    height: 44px;
    margin-bottom: 12px;
    border-radius: 8px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-color: rgb(46, 58, 82);
}

.qp-empty-text {
    font-size: 14px;
    letter-spacing: 1px;
    color: rgb(136, 146, 166);
}
