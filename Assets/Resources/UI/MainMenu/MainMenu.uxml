<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="MainMenu.uss"/>
    <ui:VisualElement name="root" class="root" picking-mode="Position">

        <ui:VisualElement name="backdrop" class="backdrop" picking-mode="Ignore"/>

        <ui:VisualElement name="panel" class="panel">
            <ui:Label text="EXTRACTION RAID" class="title"/>
            <ui:Label text="MAIN MENU" class="subtitle"/>

            <ui:VisualElement name="buttons" class="buttons">
                <ui:Button name="continueBtn" text="CONTINUE" class="menu-btn"/>
                <ui:Button name="newGameBtn" text="NEW GAME" class="menu-btn"/>
                <ui:Button name="quitBtn" text="QUIT" class="menu-btn"/>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="confirmOverlay" class="confirm-overlay" picking-mode="Position">
            <ui:VisualElement name="confirmDialog" class="confirm-dialog">
                <ui:Label text="Confirm" class="confirm-title"/>
                <ui:Label name="confirmMessage" text="Are you sure?" class="confirm-message"/>
                <ui:VisualElement name="confirmButtons" class="confirm-buttons">
                    <ui:Button name="confirmNo" text="CANCEL" class="menu-btn confirm-btn"/>
                    <ui:Button name="confirmYes" text="CONFIRM" class="menu-btn confirm-btn confirm-btn--danger"/>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

    </ui:VisualElement>
</ui:UXML>
