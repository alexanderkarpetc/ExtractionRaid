<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="EndOfRaid.uss"/>
    <ui:VisualElement name="root" class="root" picking-mode="Position">
        <ui:VisualElement name="backdrop" class="backdrop" picking-mode="Ignore"/>

        <ui:VisualElement name="card" class="card">
            <ui:Label name="title" text="EXTRACTED" class="title"/>
            <ui:Label name="subtitle" text="" class="subtitle"/>
            <ui:VisualElement name="divider" class="divider" picking-mode="Ignore"/>
            <ui:VisualElement name="actions" class="actions">
                <ui:Button name="nextBtn" text="NEXT" class="next-btn"/>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
