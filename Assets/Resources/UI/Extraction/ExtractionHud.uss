.root {
    flex-grow: 1;
    align-items: center;
    justify-content: flex-end;
}

/* Bottom-center anchor matching the concept mock. */
.extraction-widget {
    position: absolute;
    bottom: 60px;
    align-items: center;
    width: 320px;
}

/* ── Ring ─────────────────────────────────────────────── */
.ring-wrap {
    width: 152px;
    height: 152px;
    align-items: center;
    justify-content: center;
}

/* Painter2D draws here — sized to fill the wrap. */
.ring-canvas {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
}

.ring-core {
    width: 116px;
    height: 116px;
    border-radius: 58px;
    background-color: rgba(10, 14, 26, 0.85);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-color: rgba(255, 255, 255, 0.06);
    align-items: center;
    justify-content: center;
}

.seconds {
    font-size: 38px;
    -unity-font-style: bold;
    color: rgb(238, 244, 255);
    -unity-text-align: middle-center;
}

.seconds-suffix {
    font-size: 11px;
    color: rgb(159, 176, 208);
    letter-spacing: 3px;
    -unity-text-align: middle-center;
    margin-top: 2px;
}

/* ── Labels under the ring ────────────────────────────── */
.widget-label {
    align-items: center;
    margin-top: 12px;
}

.state {
    font-size: 13px;
    letter-spacing: 4px;
    color: rgb(135, 230, 255);
    -unity-text-align: middle-center;
}

.zone-name {
    font-size: 17px;
    color: rgb(238, 244, 255);
    -unity-text-align: middle-center;
    margin-top: 4px;
    letter-spacing: 1px;
}

.hint {
    font-size: 12px;
    color: rgb(159, 176, 208);
    -unity-text-align: middle-center;
    margin-top: 2px;
    white-space: normal;
}

/* ── State variants ───────────────────────────────────── */
.extraction-widget.is-progress .state {
    color: rgb(135, 230, 255);
}

.extraction-widget.is-interrupted .state {
    color: rgb(255, 93, 108);
}

.extraction-widget.is-interrupted .seconds {
    color: rgb(255, 93, 108);
}

.extraction-widget.is-complete .state {
    color: rgb(106, 255, 193);
}

.extraction-widget.is-complete .seconds {
    color: rgb(106, 255, 193);
    font-size: 42px;
}
