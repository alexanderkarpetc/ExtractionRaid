/* Battle HUD overlay — UI Toolkit panel for status effect row (Stage 3), future:
 * status tile catalog, stamina ring placeholder, etc.
 *
 * Shared tokens via _tokens.uss are pulled in by PanelSettings → ThemeStyleSheet,
 * so var(--color-X) values resolve once the theme is attached at runtime.
 *
 * Anchor + offset are set as inline styles by BattleHudOverlay.cs based on
 * the configured HudCorner enum + Vector2 padding-inward offset. The CSS
 * defaults below are simple TopLeft baseline so the layout reads even before
 * the C# side runs. */

.bh-root {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.bh-status-row {
    position: absolute;
    /* Edge anchors (top/left/right/bottom) are set inline by ApplyCornerAnchor per HudCorner.
     * Setting them in USS leaks into the "auto" branches and overrides inline keyword resets,
     * causing the row to stick to TL even when StatusRowCorner = BottomLeft. */
    flex-direction: row;
}

.bh-status-tile {
    /* +15% bump from 40 → 46px container around the (unchanged) 38px emoji.
     * Adds breathing room so the icon doesn't crowd against the tile border. */
    width: 46px;
    height: 46px;
    margin-right: 7px;
    border-radius: 8px;
    border-width: 2px;
    border-color: rgba(0, 0, 0, 0.85);
    justify-content: center;
    align-items: center;
}

.bh-status-tile:hover {
    border-color: rgba(255, 220, 100, 0.95);
}

/* Bleed light = -1 HP/sec. Subtle dark-red surface. */
.bh-status-tile--bleed-light {
    background-color: rgba(150, 30, 30, 0.85);
}

/* Bleed heavy = -3 HP/sec. Brighter red surface, accent border. */
.bh-status-tile--bleed-heavy {
    background-color: rgba(210, 25, 25, 0.95);
    border-color: rgba(255, 200, 80, 0.95);
}

.bh-status-tile__icon {
    /* +70% bump from 22 → 38px so emoji icons read at glanceable distance.
     * Single value applies to every status type's tile uniformly. */
    font-size: 38px;
    -unity-text-align: middle-center;
    color: rgba(255, 230, 230, 1);
}

/* ── Ammo counter (Stage 7) ─────────────────────────────────────────────
 * Edge anchors set inline by ApplyCornerAnchor per AmmoCorner (same approach
 * as the status row — no top/left/right/bottom here). Column, right-aligned. */
.bh-ammo {
    position: absolute;
    flex-direction: column;
    align-items: flex-end;
}

.bh-ammo__counts {
    flex-direction: row;
    align-items: flex-end;
}

/* Fixed-width number boxes so the row width stays CONSTANT regardless of digit
 * count (1 vs 100) — otherwise the variable-width mag reflows the row and the
 * whole block visibly jitters every shot. Mag right-aligned (units digit pinned
 * by the slash); reserve left-aligned (hugs the slash, grows into its box). */
.bh-ammo__mag {
    font-size: 52px;
    -unity-font-style: bold;
    color: var(--color-text-title);
    width: 90px;
    -unity-text-align: lower-right;
}

.bh-ammo__sep {
    font-size: 30px;
    color: var(--color-text-muted);
    margin-left: 4px;
    margin-right: 4px;
    margin-bottom: 5px;
}

.bh-ammo__reserve {
    font-size: 30px;
    color: var(--color-text-muted);
    width: 64px;
    -unity-text-align: lower-left;
    margin-bottom: 5px;
}

.bh-ammo__type {
    font-size: 16px;
    color: var(--color-text-muted);
    -unity-text-align: upper-right;
    margin-top: -2px;
}

/* Low magazine (≤ threshold) → gold warning. Empty → red. Only the mag number
 * recolors; reserve + type stay muted. */
.bh-ammo.is-low .bh-ammo__mag {
    color: var(--color-accent);
}

.bh-ammo.is-empty .bh-ammo__mag {
    color: var(--color-error);
}

/* ── Raid clock (M1.2) ──────────────────────────────────────────────────
 * Top-centre MM:SS. Neutral while there is plenty of time; gold at the warn
 * threshold; red at critical. Tabular-ish fixed width keeps the digits from
 * shifting the block every second. The element is display:none on levels with
 * no clock — the hideout and the shooting ranges never show it. */
.bh-timer {
    position: absolute;
    top: 14px;
    left: 0;
    right: 0;
    align-items: center;
}

.bh-timer__value {
    font-size: 30px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: var(--color-text-title);
    width: 132px;
    padding-top: 2px;
    padding-bottom: 2px;
    background-color: rgba(0, 0, 0, 0.45);
    border-radius: 6px;
}

.bh-timer.is-warn .bh-timer__value {
    color: var(--color-accent);
}

.bh-timer.is-critical .bh-timer__value {
    color: var(--color-error);
}
