/* Weapon comparison panel — two columns (hovered | baseline) positioned by WeaponComparePanel.
 * Card look mirrors the tooltip (var(--color-inset-bg) etc.); stat bars mirror the attachment
 * editor (gold fill + green/red delta segment). Tokens: Resources/UI/Theme/_tokens.uss. */

.wc-card {
    position: absolute;
    background-color: var(--color-inset-bg);
    border-color: var(--color-border);
    border-width: var(--border-tooltip);
    border-radius: var(--radius-tooltip);
    padding: var(--space-tooltip-pad-y) var(--space-tooltip-pad-x);
}

.wc-cols { flex-direction: row; }

.wc-col { width: 272px; }
.wc-col--baseline {
    margin-left: 22px;
    padding-left: 22px;
    border-left-width: 1px;
    border-left-color: var(--color-border-inset);
}

.wc-head { flex-direction: row; align-items: center; }
.wc-title {
    font-size: var(--font-tooltip-title);
    -unity-font-style: bold;
    flex-grow: 1;
    white-space: normal;
}
.wc-tag { font-size: 10px; color: var(--color-text-muted); margin-left: 6px; }
.wc-subtitle {
    font-size: var(--font-tooltip-flavor);
    color: var(--color-text-muted);
    white-space: normal;
    margin-bottom: 6px;
}
.wc-divider { height: 1px; background-color: var(--color-border-inset); margin-bottom: 6px; }

.wc-row { flex-direction: row; align-items: center; min-height: 20px; padding: 3px 0; }
.wc-label {
    font-size: var(--font-tooltip-row);
    color: var(--color-text-stat-label);
    width: 96px;
    margin-right: 10px;
    white-space: nowrap;
}
.wc-value {
    font-size: var(--font-tooltip-row);
    -unity-font-style: bold;
    color: var(--color-text-body-strong);
    flex-grow: 1;
}

/* Stacked stat row (variant B): value + Δ header line over a full-width bar. */
.wc-statrow { flex-direction: column; padding: 4px 0; }
.wc-stat-head { flex-direction: row; align-items: baseline; }
.wc-stat-label { font-size: var(--font-tooltip-row); color: var(--color-text-stat-label); flex-grow: 1; }
.wc-stat-value {
    font-size: var(--font-tooltip-row);
    -unity-font-style: bold;
    color: var(--color-text-body-strong);
    margin-left: 8px;
}
.wc-statrow .wc-bar { flex-grow: 0; margin-top: 5px; }

.wc-bar {
    flex-grow: 1;
    flex-direction: row;
    height: 6px;
    background-color: var(--color-border-inset);
    border-radius: 3px;
    overflow: hidden;
}
.wc-bar-fill { height: 100%; background-color: var(--color-accent); }
.wc-bar-delta { height: 100%; }
.wc-bar-delta--up   { background-color: rgb(80, 200, 120); }
.wc-bar-delta--down { background-color: rgb(220, 100, 100); }

.wc-delta { font-size: 11px; width: 42px; -unity-text-align: middle-right; margin-left: 10px; }
.wc-delta--up   { color: rgb(80, 200, 120); }
.wc-delta--down { color: rgb(220, 100, 100); }

.wc-footer {
    font-size: var(--font-tooltip-flavor);
    -unity-font-style: italic;
    color: var(--color-text-muted);
    margin-top: 8px;
}

/* ── Loadout footer (ammo + installed mods) ────────── */
.wc-reserve {
    margin-left: 8px;
    font-size: var(--font-tooltip-row);
    color: var(--color-text-secondary);
}
.wc-reserve--empty { color: rgb(220, 100, 100); -unity-font-style: bold; }

/* Mods stack (label above, chips full-width below) so long mod names get the whole column. */
.wc-mods-row { flex-direction: column; align-items: stretch; padding: 3px 0; }
.wc-mods-row .wc-label { margin-bottom: 4px; }
.wc-mods { flex-direction: row; flex-wrap: wrap; }
.wc-mod-chip {
    font-size: 11px;
    padding: 1px 6px;
    margin: 0 4px 3px 0;
    border-radius: 4px;
    background-color: var(--color-border-inset);
    color: var(--color-text-secondary);
}
.wc-none {
    font-size: var(--font-tooltip-row);
    color: var(--color-text-empty);
    -unity-font-style: italic;
}
