/* Tooltip overlay — single floating card positioned by TooltipController.
 * picking-mode is Ignore everywhere so the tooltip never steals pointer events
 * from the inventory / Builder underneath it.
 *
 * Tier B (compact panel) reference. Sizes / colors pull from
 * `Assets/Resources/UI/Theme/_tokens.uss` via var(--*).
 * See docs/ai/ui-styling.md for the token catalogue. */

.tt-root {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.tt-card {
    position: absolute;
    min-width: var(--size-tooltip-min-width);
    max-width: var(--size-tooltip-max-width);
    padding: var(--space-tooltip-pad-y) var(--space-tooltip-pad-x);
    background-color: var(--color-inset-bg);
    border-color: var(--color-border);
    border-width: var(--border-tooltip);
    border-radius: var(--radius-tooltip);
}

.tt-title {
    font-size: var(--font-tooltip-title);
    -unity-font-style: bold;
    color: var(--color-accent);
    white-space: normal;
    margin-bottom: 3px;
}

.tt-subtitle {
    font-size: var(--font-tooltip-flavor);
    color: var(--color-text-muted);
    white-space: normal;
    margin-bottom: 8px;
}

.tt-subtitle.is-empty {
    display: none;
}

.tt-description {
    font-size: var(--font-tooltip-flavor);
    -unity-font-style: italic;
    color: var(--color-text-secondary);
    white-space: normal;
    margin-bottom: 8px;
}

.tt-description.is-empty {
    display: none;
}

.tt-sections {
    flex-direction: column;
}

.tt-section {
    margin-top: 6px;
}

.tt-section-heading {
    font-size: var(--font-tooltip-flavor);
    -unity-font-style: bold;
    color: var(--color-section-heading);
    -unity-text-align: middle-left;
    margin-bottom: 3px;
}

.tt-section-heading.is-empty {
    display: none;
}

.tt-row {
    flex-direction: column;
    padding: var(--space-row-pad-y) 0;
}

.tt-row-header {
    flex-direction: row;
    justify-content: space-between;
}

.tt-row-label {
    font-size: var(--font-tooltip-row);
    color: var(--color-text-stat-label);
}

.tt-row-value {
    font-size: var(--font-tooltip-row);
    -unity-font-style: bold;
    color: var(--color-text-body-strong);
}

/* Full-width progress bar under the header line. Fill = goodness (higher = better). */
.tt-row-bar {
    width: 100%;
    height: 5px;
    margin-top: 3px;
    background-color: var(--color-border-inset);
    border-radius: 3px;
    overflow: hidden;
}

.tt-row-bar-fill {
    height: 100%;
    background-color: var(--color-accent);
    border-radius: 3px;
}
