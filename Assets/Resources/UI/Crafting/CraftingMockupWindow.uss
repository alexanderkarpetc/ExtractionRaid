/* ==========================================================
   Crafting mockup — UI Toolkit styles.
   Kept explicit (no 2/3-value shorthand) to avoid parser edge cases.
   ========================================================== */

/* ---------- Root / window ---------- */
.app {
    flex-grow: 1;
    padding-top: 18px;
    padding-right: 18px;
    padding-bottom: 18px;
    padding-left: 18px;
    background-color: rgba(6, 11, 21, 0.55);
}

.window {
    flex-grow: 1;
    background-color: rgb(28, 32, 38);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(150, 160, 176, 0.18);
    border-right-color: rgba(150, 160, 176, 0.18);
    border-top-color: rgba(150, 160, 176, 0.18);
    border-bottom-color: rgba(150, 160, 176, 0.18);
    border-top-left-radius: 20px;
    border-top-right-radius: 20px;
    border-bottom-left-radius: 20px;
    border-bottom-right-radius: 20px;
    overflow: hidden;
    color: rgb(233, 238, 248);
}

/* ---------- Topbar ---------- */
.topbar {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding-top: 18px;
    padding-right: 22px;
    padding-bottom: 14px;
    padding-left: 22px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(196, 204, 219, 0.15);
}

.title {
    font-size: 18px;
    -unity-font-style: bold;
    color: rgb(233, 238, 248);
}

.close-btn {
    width: 36px;
    height: 36px;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-left-radius: 10px;
    border-bottom-right-radius: 10px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(178, 188, 205, 0.24);
    border-right-color: rgba(178, 188, 205, 0.24);
    border-top-color: rgba(178, 188, 205, 0.24);
    border-bottom-color: rgba(178, 188, 205, 0.24);
    background-color: rgba(14, 23, 40, 0.9);
    color: rgb(144, 160, 189);
    font-size: 18px;
    -unity-text-align: middle-center;
    margin-left: 0;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
}

.close-btn:hover {
    border-left-color: rgb(42, 68, 109);
    border-right-color: rgb(42, 68, 109);
    border-top-color: rgb(42, 68, 109);
    border-bottom-color: rgb(42, 68, 109);
    color: rgb(233, 238, 248);
}

/* ---------- Tabs ---------- */
.tabs {
    flex-direction: row;
    padding-left: 22px;
    padding-right: 22px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(196, 204, 219, 0.15);
}

.tab {
    padding-top: 16px;
    padding-right: 18px;
    padding-bottom: 14px;
    padding-left: 18px;
    margin-top: 0;
    margin-bottom: 0;
    margin-left: 0;
    margin-right: 0;
    background-color: rgba(0, 0, 0, 0);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 2px;
    border-bottom-color: rgba(0, 0, 0, 0);
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
    color: rgb(144, 160, 189);
    font-size: 12px;
    -unity-font-style: bold;
}

.tab:hover {
    color: rgb(233, 238, 248);
}

.tab--active {
    color: rgb(233, 238, 248);
    border-bottom-color: rgb(75, 121, 255);
}

/* ---------- Content grid ---------- */
.content {
    flex-direction: row;
    flex-grow: 1;
    min-height: 0;
}

/* ---------- Sidebar ---------- */
.sidebar {
    width: 44%;
    border-right-width: 1px;
    border-right-color: rgba(196, 204, 219, 0.15);
    flex-direction: column;
}

.sidebar-toolbar {
    flex-direction: row;
    align-items: center;
    padding-top: 16px;
    padding-right: 16px;
    padding-bottom: 16px;
    padding-left: 16px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(196, 204, 219, 0.15);
}

.toolbar-left {
    flex-direction: row;
    margin-right: 12px;
}

.toolbar-btn {
    min-width: 40px;
    height: 40px;
    padding-left: 12px;
    padding-right: 12px;
    padding-top: 0;
    padding-bottom: 0;
    margin-top: 0;
    margin-bottom: 0;
    margin-left: 0;
    margin-right: 8px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(178, 188, 205, 0.24);
    border-right-color: rgba(178, 188, 205, 0.24);
    border-top-color: rgba(178, 188, 205, 0.24);
    border-bottom-color: rgba(178, 188, 205, 0.24);
    background-color: rgba(14, 23, 40, 0.9);
    color: rgb(144, 160, 189);
    font-size: 14px;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-left-radius: 10px;
    border-bottom-right-radius: 10px;
}

.toolbar-btn:hover {
    color: rgb(233, 238, 248);
    border-left-color: rgb(42, 68, 109);
    border-right-color: rgb(42, 68, 109);
    border-top-color: rgb(42, 68, 109);
    border-bottom-color: rgb(42, 68, 109);
}

.toolbar-btn--active {
    color: rgb(233, 238, 248);
    border-left-color: rgba(58, 225, 143, 0.55);
    border-right-color: rgba(58, 225, 143, 0.55);
    border-top-color: rgba(58, 225, 143, 0.55);
    border-bottom-color: rgba(58, 225, 143, 0.55);
}

.search {
    flex-grow: 1;
    height: 40px;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-left-radius: 10px;
    border-bottom-right-radius: 10px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(178, 188, 205, 0.24);
    border-right-color: rgba(178, 188, 205, 0.24);
    border-top-color: rgba(178, 188, 205, 0.24);
    border-bottom-color: rgba(178, 188, 205, 0.24);
    background-color: rgba(12, 20, 35, 0.95);
    color: rgb(233, 238, 248);
    padding-left: 14px;
    padding-right: 14px;
    margin-top: 0;
    margin-bottom: 0;
}

.search > TextInput {
    background-color: rgba(0, 0, 0, 0);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    color: rgb(233, 238, 248);
    padding-left: 0;
}

.search-placeholder {
    position: absolute;
    left: 14px;
    top: 0;
    bottom: 0;
    -unity-text-align: middle-left;
    color: rgb(95, 115, 151);
    font-size: 14px;
}

/* ---------- Item grid ---------- */
.item-grid-wrap {
    flex-grow: 1;
    min-height: 0;
}

.item-grid-wrap .unity-scroll-view__content-container {
    padding-top: 16px;
    padding-right: 16px;
    padding-bottom: 16px;
    padding-left: 16px;
}

.item-grid {
    flex-direction: row;
    flex-wrap: wrap;
}

.item-card {
    width: 128px;
    height: 128px;
    margin-top: 6px;
    margin-right: 6px;
    margin-bottom: 6px;
    margin-left: 6px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(36, 56, 89, 0.95);
    border-right-color: rgba(36, 56, 89, 0.95);
    border-top-color: rgba(36, 56, 89, 0.95);
    border-bottom-color: rgba(36, 56, 89, 0.95);
    border-top-left-radius: 14px;
    border-top-right-radius: 14px;
    border-bottom-left-radius: 14px;
    border-bottom-right-radius: 14px;
    background-color: rgb(30, 34, 40);
    padding-top: 12px;
    padding-right: 12px;
    padding-bottom: 12px;
    padding-left: 12px;
    align-items: center;
    justify-content: center;
    color: rgb(233, 238, 248);
}

.item-card:hover {
    border-left-color: rgb(42, 68, 109);
    border-right-color: rgb(42, 68, 109);
    border-top-color: rgb(42, 68, 109);
    border-bottom-color: rgb(42, 68, 109);
}

.item-card--selected {
    border-left-color: rgba(58, 225, 143, 0.55);
    border-right-color: rgba(58, 225, 143, 0.55);
    border-top-color: rgba(58, 225, 143, 0.55);
    border-bottom-color: rgba(58, 225, 143, 0.55);
    background-color: rgb(37, 42, 49);
}

.item-count {
    position: absolute;
    top: 6px;
    right: 6px;
    font-size: 11px;
    color: rgb(95, 115, 151);
    padding-top: 3px;
    padding-right: 6px;
    padding-bottom: 3px;
    padding-left: 6px;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
    background-color: rgba(20, 31, 52, 0.95);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(34, 52, 83, 0.8);
    border-right-color: rgba(34, 52, 83, 0.8);
    border-top-color: rgba(34, 52, 83, 0.8);
    border-bottom-color: rgba(34, 52, 83, 0.8);
}

.icon-box {
    width: 56px;
    height: 56px;
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom-left-radius: 12px;
    border-bottom-right-radius: 12px;
    background-color: rgba(23, 36, 58, 0.98);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(126, 159, 222, 0.3);
    border-right-color: rgba(126, 159, 222, 0.3);
    border-top-color: rgba(126, 159, 222, 0.3);
    border-bottom-color: rgba(126, 159, 222, 0.3);
    justify-content: center;
    align-items: center;
    font-size: 20px;
}

.item-name {
    font-size: 14px;
    -unity-font-style: bold;
    margin-top: 6px;
    color: rgb(233, 238, 248);
    -unity-text-align: middle-center;
    white-space: normal;
}

.item-meta {
    font-size: 12px;
    color: rgb(58, 225, 143);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

/* ---------- Sidebar footer ---------- */
.sidebar-footer {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding-top: 14px;
    padding-right: 16px;
    padding-bottom: 16px;
    padding-left: 16px;
    border-top-width: 1px;
    border-top-color: rgba(196, 204, 219, 0.15);
}

.toggle {
    color: rgb(144, 160, 189);
    font-size: 12px;
    -unity-font-style: bold;
}

.footer-count {
    color: rgb(144, 160, 189);
    font-size: 12px;
    -unity-font-style: bold;
}

/* ---------- Details ---------- */
.details {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
    flex-direction: column;
}

.details-top {
    flex-direction: row;
    min-height: 244px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(196, 204, 219, 0.15);
}

.hero-copy {
    flex-grow: 1;
    flex-basis: 0;
    padding-top: 26px;
    padding-right: 26px;
    padding-bottom: 26px;
    padding-left: 26px;
}

.rarity-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 10px;
}

.hero-title {
    font-size: 26px;
    -unity-font-style: bold;
    color: rgb(233, 238, 248);
    margin-right: 12px;
}

.rarity-badge {
    padding-top: 2px;
    padding-right: 10px;
    padding-bottom: 2px;
    padding-left: 10px;
    border-top-left-radius: 999px;
    border-top-right-radius: 999px;
    border-bottom-left-radius: 999px;
    border-bottom-right-radius: 999px;
    font-size: 11px;
    -unity-font-style: bold;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(58, 225, 143, 0.35);
    border-right-color: rgba(58, 225, 143, 0.35);
    border-top-color: rgba(58, 225, 143, 0.35);
    border-bottom-color: rgba(58, 225, 143, 0.35);
    color: rgb(58, 225, 143);
    background-color: rgba(22, 58, 46, 0.4);
    -unity-text-align: middle-center;
}

.rarity-badge--common {
    border-left-color: rgba(178, 188, 205, 0.45);
    border-right-color: rgba(178, 188, 205, 0.45);
    border-top-color: rgba(178, 188, 205, 0.45);
    border-bottom-color: rgba(178, 188, 205, 0.45);
    color: rgb(196, 204, 219);
    background-color: rgba(40, 48, 62, 0.45);
}

.rarity-badge--uncommon {
    border-left-color: rgba(58, 225, 143, 0.55);
    border-right-color: rgba(58, 225, 143, 0.55);
    border-top-color: rgba(58, 225, 143, 0.55);
    border-bottom-color: rgba(58, 225, 143, 0.55);
    color: rgb(58, 225, 143);
    background-color: rgba(22, 58, 46, 0.45);
}

.rarity-badge--rare {
    border-left-color: rgba(75, 121, 255, 0.6);
    border-right-color: rgba(75, 121, 255, 0.6);
    border-top-color: rgba(75, 121, 255, 0.6);
    border-bottom-color: rgba(75, 121, 255, 0.6);
    color: rgb(113, 152, 255);
    background-color: rgba(24, 40, 84, 0.5);
}

.rarity-badge--epic {
    border-left-color: rgba(185, 115, 255, 0.6);
    border-right-color: rgba(185, 115, 255, 0.6);
    border-top-color: rgba(185, 115, 255, 0.6);
    border-bottom-color: rgba(185, 115, 255, 0.6);
    color: rgb(201, 148, 255);
    background-color: rgba(56, 30, 82, 0.55);
}

.subtitle {
    color: rgb(144, 160, 189);
    font-size: 15px;
    margin-bottom: 18px;
}

.description {
    color: rgb(194, 204, 224);
    font-size: 13px;
    white-space: normal;
}

.hero-visual {
    width: 320px;
    border-left-width: 1px;
    border-left-color: rgba(196, 204, 219, 0.15);
    background-color: rgb(14, 20, 34);
    justify-content: center;
    align-items: center;
}

.hero-emoji {
    font-size: 96px;
    color: rgb(233, 238, 248);
    -unity-font-style: bold;
}

/* ---------- Details middle ---------- */
.details-middle {
    flex-grow: 1;
    flex-direction: row;
    min-height: 0;
}

.parameters {
    width: 46%;
    border-right-width: 1px;
    border-right-color: rgba(196, 204, 219, 0.15);
    flex-direction: column;
}

.requirements-side {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
    flex-direction: column;
}

.section-title {
    padding-top: 18px;
    padding-right: 26px;
    padding-bottom: 10px;
    padding-left: 26px;
    font-size: 11px;
    color: rgb(144, 160, 189);
    -unity-font-style: bold;
}

.stats-list {
    flex-grow: 1;
    min-height: 0;
}

.stats-list .unity-scroll-view__content-container {
    padding-top: 0;
    padding-right: 26px;
    padding-bottom: 18px;
    padding-left: 26px;
}

.stat-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding-top: 12px;
    padding-bottom: 12px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(130, 157, 205, 0.12);
}

.stat-label {
    color: rgb(188, 199, 219);
    font-size: 14px;
}

.stat-value {
    color: rgb(233, 238, 248);
    font-size: 18px;
    -unity-font-style: bold;
    -unity-text-align: middle-right;
    min-width: 80px;
}

/* ---------- Requirements ---------- */
.requirements-top {
    border-bottom-width: 1px;
    border-bottom-color: rgba(196, 204, 219, 0.15);
}

.requirement-grid {
    flex-direction: row;
    flex-wrap: wrap;
    padding-top: 6px;
    padding-right: 22px;
    padding-bottom: 18px;
    padding-left: 22px;
}

.req-card {
    width: 128px;
    height: 128px;
    margin-top: 6px;
    margin-right: 6px;
    margin-bottom: 6px;
    margin-left: 6px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(178, 188, 205, 0.24);
    border-right-color: rgba(178, 188, 205, 0.24);
    border-top-color: rgba(178, 188, 205, 0.24);
    border-bottom-color: rgba(178, 188, 205, 0.24);
    border-top-left-radius: 14px;
    border-top-right-radius: 14px;
    border-bottom-left-radius: 14px;
    border-bottom-right-radius: 14px;
    background-color: rgb(30, 34, 40);
    padding-top: 12px;
    padding-right: 12px;
    padding-bottom: 12px;
    padding-left: 12px;
    align-items: center;
    justify-content: center;
}

.req-card--ready {
    border-left-color: rgba(58, 225, 143, 0.55);
    border-right-color: rgba(58, 225, 143, 0.55);
    border-top-color: rgba(58, 225, 143, 0.55);
    border-bottom-color: rgba(58, 225, 143, 0.55);
}

.req-name {
    font-size: 13px;
    -unity-font-style: bold;
    margin-top: 6px;
    color: rgb(233, 238, 248);
    -unity-text-align: middle-center;
    white-space: normal;
}

.req-count {
    font-size: 13px;
    -unity-font-style: bold;
    color: rgb(58, 225, 143);
    -unity-text-align: middle-center;
}

.req-count--missing {
    color: rgb(255, 118, 118);
}

/* ---------- Craft meta + panel ---------- */
.craft-meta {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding-top: 14px;
    padding-right: 22px;
    padding-bottom: 14px;
    padding-left: 22px;
    border-top-width: 1px;
    border-top-color: rgba(196, 204, 219, 0.15);
    border-bottom-width: 1px;
    border-bottom-color: rgba(196, 204, 219, 0.15);
    color: rgb(144, 160, 189);
    font-size: 12px;
    -unity-font-style: bold;
}

.workbench-value {
    color: rgb(58, 225, 143);
    margin-left: 6px;
}

.craft-panel {
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-end;
    padding-top: 18px;
    padding-right: 22px;
    padding-bottom: 20px;
    padding-left: 22px;
}

.amount-block {
    flex-direction: column;
}

.amount-row {
    flex-direction: row;
    align-items: center;
}

.amount-label {
    font-size: 11px;
    color: rgb(144, 160, 189);
    -unity-font-style: bold;
    margin-bottom: 10px;
}

.amount-btn {
    width: 40px;
    height: 40px;
    margin-top: 0;
    margin-right: 10px;
    margin-bottom: 0;
    margin-left: 0;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    font-size: 22px;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-left-radius: 10px;
    border-bottom-right-radius: 10px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(178, 188, 205, 0.24);
    border-right-color: rgba(178, 188, 205, 0.24);
    border-top-color: rgba(178, 188, 205, 0.24);
    border-bottom-color: rgba(178, 188, 205, 0.24);
    background-color: rgba(14, 23, 40, 0.9);
    color: rgb(233, 238, 248);
    -unity-text-align: middle-center;
}

.amount-btn:hover {
    border-left-color: rgb(42, 68, 109);
    border-right-color: rgb(42, 68, 109);
    border-top-color: rgb(42, 68, 109);
    border-bottom-color: rgb(42, 68, 109);
}

.amount-value {
    min-width: 34px;
    -unity-text-align: middle-center;
    font-size: 26px;
    -unity-font-style: bold;
    margin-left: 4px;
    margin-right: 14px;
}

.action-btn {
    height: 40px;
    padding-left: 16px;
    padding-right: 16px;
    padding-top: 0;
    padding-bottom: 0;
    margin-top: 0;
    margin-right: 10px;
    margin-bottom: 0;
    margin-left: 0;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-left-radius: 10px;
    border-bottom-right-radius: 10px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(178, 188, 205, 0.24);
    border-right-color: rgba(178, 188, 205, 0.24);
    border-top-color: rgba(178, 188, 205, 0.24);
    border-bottom-color: rgba(178, 188, 205, 0.24);
    background-color: rgba(14, 23, 40, 0.9);
    color: rgb(144, 160, 189);
    font-size: 11px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.action-btn:hover {
    color: rgb(233, 238, 248);
    border-left-color: rgb(42, 68, 109);
    border-right-color: rgb(42, 68, 109);
    border-top-color: rgb(42, 68, 109);
    border-bottom-color: rgb(42, 68, 109);
}

.craft-btn {
    min-width: 240px;
    height: 52px;
    font-size: 14px;
    margin-right: 0;
}

.action-btn.primary {
    background-color: rgb(78, 117, 231);
    color: rgb(255, 255, 255);
    border-left-color: rgba(110, 149, 255, 0.65);
    border-right-color: rgba(110, 149, 255, 0.65);
    border-top-color: rgba(110, 149, 255, 0.65);
    border-bottom-color: rgba(110, 149, 255, 0.65);
}

.action-btn.primary:hover {
    background-color: rgb(91, 134, 255);
    color: rgb(255, 255, 255);
}

.action-btn.primary:disabled {
    background-color: rgb(60, 70, 92);
    color: rgb(140, 150, 170);
}
