<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="../Inventory/_inv-slot.uss" />
    <Style src="HotbarOverlay.uss" />
    <ui:VisualElement name="root" picking-mode="Ignore" class="hb-root">
        <!-- Bottom-center bar: [weapon slots 1-2] [separator] [quick slots 3-9].
             Both strips are populated at runtime by HotbarOverlay.cs from the
             respective constants (WeaponSlotCount / QuickSlotCount). The bar
             centers as a unit, so the quick strip shifts right of dead-center by
             half the weapon-strip + separator width — intended (spec decision #5). -->
        <ui:VisualElement name="bar" picking-mode="Ignore" class="hb-bar">
            <ui:VisualElement name="weapon-strip" class="hb-weapon-strip" />
            <ui:VisualElement name="separator" picking-mode="Ignore" class="hb-separator" />
            <ui:VisualElement name="strip" class="hb-strip" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
