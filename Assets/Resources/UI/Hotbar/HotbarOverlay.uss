/* Hotbar overlay — bottom-center strip of QuickSlot bindings.
 *
 * State source: InventoryState.QuickSlotBindings[7] (medkit/bandage/grenade
 * shortcuts), keys 3-9. NOT to be confused with PlayerEntityState.Hotbar[2]
 * which holds equipped weapons (separate system, no UI today).
 *
 * Tier: compact "always-on" HUD strip — neither modal (Tier A) nor
 * popover (Tier B); shares the same token palette via _tokens.uss.
 * Sizes / colors pull from the project tokens — see docs/ai/ui-styling.md. */

.hb-root {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

/* Bottom-center bar holding both strips. Absolute-positioned (was on .hb-strip);
 * the strips are now plain flex children so weapon + quick sit in one row with a
 * separator between. align-items: flex-end bottom-aligns slots of differing height. */
.hb-bar {
    position: absolute;
    bottom: 32px;
    left: 50%;
    translate: -50% 0;
    flex-direction: row;
    align-items: flex-end;
}

.hb-weapon-strip {
    flex-direction: row;
}

.hb-strip {
    flex-direction: row;
}

/* Gap between weapon strip and quick strip. Width overridden at runtime from
 * ViewCheatsBattleHudSection.HotbarWeaponSeparatorPx (default mirrors this). */
.hb-separator {
    width: 18px;
}

/* Weapon slots mirror the quick-strip row spacing. */
.hb-weapon-strip > .inv-slot--bp {
    margin-bottom: 0;
    margin-right: 10px;
}

.hb-weapon-strip > .inv-slot--bp:last-child {
    margin-right: 0;
}

.hb-weapon-strip > .inv-slot:hover {
    border-color: var(--color-hint);
}

/* Equipped weapon slot — accent border (the fill tint is pushed inline from
 * ViewCheatsBattleHudSection.WeaponSlotActiveTint, so only the border lives here). */
.hb-weapon-strip > .inv-slot.is-active {
    border-color: var(--color-accent);
}

/* Empty weapon slot — dim inset surface (mirrors quick-strip empty treatment). */
.hb-weapon-strip > .inv-slot.is-empty {
    background-color: var(--color-card-bg-disabled);
    border-color: var(--color-border-inset);
}

/* ── Slot ──────────────────────────────────────────────
 * Slot cells use the shared `.inv-slot` + `.inv-slot--bp` classes via
 * `_inv-slot.uss` (imported in HotbarOverlay.uxml). The rules below are
 * scoped overrides: hotbar-only state highlights + strip-row margin tweaks.
 * The drag ghost reuses `.inv-drag-ghost` from the same shared file. */

/* `.inv-slot--bp` has margin-bottom: 7px (designed for the multi-row backpack
 * grid). У single-row strip the bottom margin would shift slots up відносно
 * `.hb-strip` bottom anchor. Strip-scope it back to 0. Margin-right same
 * 10px familiar до hotbar — closer to the previous spacing than inventory's
 * 9px (cosmetic preference, easy to revert). */
.hb-strip > .inv-slot--bp {
    margin-bottom: 0;
    margin-right: 10px;
}

.hb-strip > .inv-slot--bp:last-child {
    margin-right: 0;
}

/* Hover border highlight — inventory backpack slots don't have this (drag
 * highlight там делает свою роботу). Hotbar HUD читається краще з hover. */
.hb-strip > .inv-slot:hover {
    border-color: var(--color-hint);
}

/* Empty slot — dimmer surface so the eye reads "nothing bound here".
 * Class toggled у Refresh based on item == null. Inventory has no
 * .is-empty concept (renders empty state via inv-slot__empty Label alone). */
.hb-strip > .inv-slot.is-empty {
    background-color: var(--color-card-bg-disabled);
    border-color: var(--color-border-inset);
}

/* Active state — fired while the player holds the bound key
 * (QuickSlotHeld → PlayerEntityState.ActiveQuickSlot). */
.hb-strip > .inv-slot.is-active {
    border-color: var(--color-accent);
    background-color: var(--color-card-bg-selected);
}

/* ── Slot children — hotbar-specific ─────────────────
 * Only the always-on "3..9" key hint is hotbar-specific. The other slot
 * children (`.inv-slot__name/__resource/__quest/__durability`) live у the
 * shared _inv-slot.uss.
 *
 * Default = occupied look: accent text + header-bg pill, mirror of
 * `.inv-slot__key` (the inventory's bound-item badge). When the slot is
 * empty we revert to plain muted-gray text (no pill) — see `.is-empty`
 * override нижче. The default-occupied / override-empty split avoids
 * needing `:not()` (not supported by Unity UI Toolkit). */

.hb-slot__key {
    position: absolute;
    top: 6px;
    left: 8px;
    font-size: var(--font-card-kind);
    -unity-font-style: bold;
    color: var(--color-accent);
    background-color: var(--color-header-bg);
    padding: 1px 6px;
    border-radius: 4px;
}

.hb-strip > .inv-slot.is-empty .hb-slot__key {
    color: var(--color-text-muted);
    background-color: rgba(0, 0, 0, 0);
    padding: 0;
    border-radius: 0;
}

.hb-strip > .inv-slot.is-active .hb-slot__key {
    color: var(--color-accent);
}

/* ── Bind picker (click on empty slot → choose item from backpack) ── */

/* Fullscreen click-catcher behind the picker. Picking-mode Position so it
 * intercepts clicks anywhere on screen — clicking it closes the picker.
 * Background fully transparent (no dim) — the hotbar is HUD, not modal. */
.hb-picker-backdrop {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0);
}

.hb-picker {
    position: absolute;
    min-width: 220px;
    max-width: 320px;
    padding: var(--space-tooltip-pad-y) var(--space-tooltip-pad-x);
    background-color: var(--color-inset-bg);
    border-color: var(--color-border);
    border-width: var(--border-tooltip);
    border-radius: var(--radius-tooltip);
    flex-direction: column;
}

.hb-picker__title {
    font-size: var(--font-tooltip-flavor);
    -unity-font-style: bold;
    color: var(--color-section-heading);
    margin-bottom: 6px;
}

.hb-picker__row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding: 6px 8px;
    margin-top: 2px;
    border-radius: 4px;
    background-color: rgba(0, 0, 0, 0);
}

.hb-picker__row:hover {
    background-color: var(--color-card-bg-hover);
}

.hb-picker__row-label {
    font-size: var(--font-tooltip-row);
    color: var(--color-text-body);
    flex-grow: 1;
}

.hb-picker__row-count {
    font-size: var(--font-tooltip-flavor);
    color: var(--color-text-muted);
    -unity-font-style: bold;
}

.hb-picker__empty {
    font-size: var(--font-tooltip-flavor);
    -unity-font-style: italic;
    color: var(--color-text-empty);
    padding: 8px 0;
    -unity-text-align: middle-center;
}

/* Drag ghost reuses `.inv-drag-ghost` + `.inv-slot--bp` from _inv-slot.uss
 * (full-slot clone з opacity 0.85 + accent border). No hotbar-specific
 * overrides — pixel parity з inventory ghost is the goal. */
